<UserControl x:Class="CollectaMundo.Views.SideMenuLeft.SideMenuFilteringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:sideMenuVm="clr-namespace:CollectaMundo.ViewModels.SideMenuLeft"
             xmlns:sideMenuLeft="clr-namespace:CollectaMundo.Views.SideMenuLeft"
             mc:Ignorable="d" 
             d:Style="{StaticResource {x:Type UserControl}}"
             d:DataContext="{d:DesignInstance Type=sideMenuVm:SideMenuFilteringViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="700" d:DesignWidth="800">
    <Grid x:Name="GridFiltering">

        <Button x:Name="ClearFiltersButton" Content="Clear filters" Margin="10,0,0,0" VerticalAlignment="Top" Height="20" Command="{Binding FilterVM.ClearFiltersCommand}"/>

        <!--Color filtering-->
        <ListBox ItemsSource="{Binding FilterVM.Filters[Colors].FilterOptions}"
                             SelectionMode="Extended" Margin="0,30,0,0" Width="120" HorizontalAlignment="Left"
                             Height="170" VerticalAlignment="Top" Background="{x:Null}" 
                             BorderBrush="{x:Null}" Foreground="{x:Null}">
            <ListBox.Resources>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="SnapsToDevicePixels" Value="true" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <CheckBox Margin="5,2"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Content="{Binding OptionName}"
                                                      FontSize="{Binding ., Converter={StaticResource ColorlessFontConverter}, ConverterParameter=30}"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.Resources>
        </ListBox>
        <ListBox ItemsSource="{Binding ColorIconsViewModel.Cards}"
                             Margin="20,30,0,0" Width="50" HorizontalAlignment="Left"
                             Height="160" VerticalAlignment="Top" Background="{x:Null}" 
                             BorderBrush="{x:Null}" Foreground="{x:Null}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding ManaCostImage}" Height="15" HorizontalAlignment="Right"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ComboBox DataContext="{Binding FilterVM.Filters[Colors]}"
                              Width="60"
                              Margin="190,35,0,0"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Right"
                              ItemsSource="{Binding AvailableOperators}"
                              SelectedItem="{Binding OperatorSelection, Mode=TwoWay}">
        </ComboBox>

        <!--Mana value filtering-->
        <Label x:Name="ManaValueLabel" Content="Mana value is: " HorizontalAlignment="Left" Margin="0,190,0,0" VerticalAlignment="Top" Style="{StaticResource BelerenBold}"/>
        <Grid Margin="10,215,0,0" VerticalAlignment="Top" Height="20" Width="240">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Operator Selection -->
            <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding FilterVM.Filters[ManaValue].AvailableOperators}"
                                  SelectedItem="{Binding FilterVM.Filters[ManaValue].OperatorSelection, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource OperatorToSymbolConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <!-- Numeric Value Selection -->
            <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding FilterVM.Filters[ManaValue].AvailableNumericOptions}"
                                  SelectedItem="{Binding FilterVM.Filters[ManaValue].SelectedNumericValue, Mode=TwoWay}"
                                  HorizontalAlignment="Right"
                                  Width="80"/>
        </Grid>

        <StackPanel Margin="10,245,0,0">
            <sideMenuLeft:FilterComboBoxPairRowUserControl DataContext="{Binding FilterVM.Filters[Rarity]}" />
            <sideMenuLeft:FilterComboBoxPairRowUserControl DataContext="{Binding FilterVM.Filters[SuperTypes]}" />
            <sideMenuLeft:FilterComboBoxPairRowUserControl DataContext="{Binding FilterVM.Filters[Types]}" />
            <sideMenuLeft:FilterComboBoxPairRowUserControl DataContext="{Binding FilterVM.Filters[SubTypes]}" />
            <sideMenuLeft:FilterComboBoxPairRowUserControl DataContext="{Binding FilterVM.Filters[Keywords]}" />
            <sideMenuLeft:FilterComboBoxPairRowUserControl DataContext="{Binding FilterVM.Filters[Finishes]}" />
        </StackPanel>
        
        <!--Rulestext filtering-->
        <TextBox x:Name="FilterTextTextBox"
                         DataContext="{Binding FilterVM.Filters[Text]}"
                         Text="{Binding FreetextSearch, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                         HorizontalAlignment="Left" 
                         Margin="10,425,0,0" 
                         TextWrapping="Wrap" 
                         Foreground="{Binding TextForeground, Mode=TwoWay}" 
                         VerticalAlignment="Top" 
                         Width="240" Height="45" 
                         Background="White">
            <i:Interaction.Triggers>
                <!-- Enter + Escape key binding -->
                <i:EventTrigger EventName="PreviewKeyDown">
                    <i:InvokeCommandAction Command="{Binding KeyPressedCommand}"
                           PassEventArgsToCommand="True"/>
                </i:EventTrigger>

                <!-- Focus behavior (unchanged) -->
                <i:EventTrigger EventName="GotFocus">
                    <i:InvokeCommandAction Command="{Binding RulesTextBoxGotFocusCommand}" />
                </i:EventTrigger>
                <i:EventTrigger EventName="LostFocus">
                    <i:InvokeCommandAction Command="{Binding RulesTextBoxLostFocusCommand}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </TextBox>

        <StackPanel Margin="10,480,0,0" Visibility="{Binding IsMyCollectionPageActive, Converter={StaticResource BoolToVisibilityConverter}}">
            <sideMenuLeft:FilterComboBoxPairRowUserControl DataContext="{Binding FilterVM.Filters[Language]}" />
            <sideMenuLeft:FilterComboBoxPairRowUserControl DataContext="{Binding FilterVM.Filters[SelectedCondition]}" />
            <sideMenuLeft:FilterComboBoxPairRowUserControl DataContext="{Binding FilterVM.Filters[SelectedFinish]}" />
        </StackPanel>
        
        <CheckBox  Content="Filter on cards for trade"
                   Visibility="{Binding IsMyCollectionPageActive, Converter={StaticResource BoolToVisibilityConverter}}"
                   IsChecked="{Binding FilterVM.Filters[CardsForTrade].IsTradeChecked, Mode=TwoWay}"
                   HorizontalAlignment="Left" Margin="10,570,0,0" VerticalAlignment="Top"/>
        <CheckBox Content="Filter on cards NOT for trade"
                  Visibility="{Binding IsMyCollectionPageActive, Converter={StaticResource BoolToVisibilityConverter}}"
                  IsChecked="{Binding FilterVM.Filters[CardsForTrade].IsNotTradeChecked, Mode=TwoWay}"
                  HorizontalAlignment="Left" Margin="10,590,0,0" VerticalAlignment="Top"/>

    </Grid>
</UserControl>
