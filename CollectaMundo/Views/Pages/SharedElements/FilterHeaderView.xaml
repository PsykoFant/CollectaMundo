<UserControl x:Class="CollectaMundo.Views.Pages.SharedElements.FilterHeaderView"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:CollectaMundo.Presentation.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="40"
             d:DesignWidth="300">

    <Grid DataContext="{Binding ResolvedFilterItem, ElementName=root}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Content="{Binding HeaderText, ElementName=root}" VerticalAlignment="Center" Grid.Column="0"/>

        <ComboBox Grid.Column="1"
                  IsTextSearchEnabled="False"
                  HorizontalAlignment="Stretch"
                  Height="20"
                  IsEditable="True"
                  Width="{Binding ComboWidth, ElementName=root}"
                  ItemsSource="{Binding FilteredOptions}"
                  DisplayMemberPath="OptionName"
                  Text="{Binding FreetextSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
                    <i:InvokeCommandAction Command="{Binding ComboBoxSelectionChangedCommand}"
                                           CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>

            <i:Interaction.Behaviors>
                <behaviors:ComboBoxUnselector ClearTrigger="{Binding ClearComboBoxSelectionTrigger}" />
            </i:Interaction.Behaviors>

            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
    </Grid>
</UserControl>
