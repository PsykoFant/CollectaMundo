# Normalize all text files to LF line endings
* text eol=lf

# Keep LF explicitly for common code files
*.cs      text eol=lf
*.xaml    text eol=lf
*.csproj  text eol=lf
*.props   text eol=lf
*.targets text eol=lf
*.xml     text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf
*.config  text eol=lf
*.txt     text eol=lf

# Shell scripts already expect LF
*.sh      text eol=lf

# Binary files - never touch line endings
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.dll     binary
*.exe     binary
*.pdf     binary
*.xlsx 	  binary

