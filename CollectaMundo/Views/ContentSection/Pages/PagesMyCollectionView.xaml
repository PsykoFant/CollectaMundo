<UserControl x:Class="CollectaMundo.Views.ContentSection.Pages.PagesMyCollectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:pagesVm="clr-namespace:CollectaMundo.ViewModels.Pages"
             xmlns:sharedElements="clr-namespace:CollectaMundo.Views.ContentSection.Pages.SharedElements"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:CollectaMundo.Presentation.Behaviors"
             xmlns:converters="clr-namespace:CollectaMundo.Presentation.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=pagesVm:PagesMyCollectionViewModel, IsDesignTimeCreatable=False}"
             d:Style="{StaticResource {x:Type UserControl}}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="270"/>   <!-- 0 - Top Panel -->
            <RowDefinition Height="25"/>    <!-- 1 - Actions -->
            <RowDefinition Height="*"/>     <!-- 2 - Data Grid -->
        </Grid.RowDefinitions>

        <!-- 0 - Top Panel -->
        <sharedElements:CardListPageTopPanelUserControl Grid.Row="0" />

        <!-- 1 - Actions -->
        <Button Grid.Row="1"
                Content="Edit selected cards"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Width="120" Height="20"
                Visibility="{Binding ElementName=MyCollectionDataGrid, Path=SelectedItems.Count, Converter={StaticResource CountToVisibilityConverter}}"
                Command="{Binding ModifyCollectionViewModel.EditSelectedCardsCommand}"
                CommandParameter="{Binding SelectedItems, ElementName=MyCollectionDataGrid}" />

        <!-- 2 - Data Grid -->
        <DataGrid Grid.Row="2"
                  x:Name="MyCollectionDataGrid"
                  ItemsSource="{Binding CardsVM.FilteredCards, NotifyOnTargetUpdated=True}"
                  Style="{StaticResource CardGridBaseStyle}" 
                  SelectedItem="{Binding SelectedCard, Mode=TwoWay}"
                  behaviors:DataGridClearSelectionBehavior.ClearSelectionTrigger="{Binding ModifyCollectionViewModel.ClearSelectionTrigger, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Name" MinWidth="150" SortMemberPath="Name">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <sharedElements:FilterHeaderUserControl DataContext="{Binding DataContext.NameFilter, ElementName=MyCollectionDataGrid}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Set Name" MinWidth="150"  SortMemberPath="SetName">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <sharedElements:FilterHeaderUserControl DataContext="{Binding DataContext.SetNameFilter, ElementName=MyCollectionDataGrid}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SetName}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Icon" IsReadOnly="True" Width="Auto" SortMemberPath="ReleaseDate">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding KeyRuneImage}" Width="20" Height="20" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Mana Cost" Width="Auto" IsReadOnly="True" SortMemberPath="ManaValue">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding ManaCostImage}" Height="20" HorizontalAlignment="Right"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Card Types" Width="*" SortMemberPath="Type">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Type}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Finish" Width="*" SortMemberPath="SelectedFinish">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SelectedFinish}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Language" Width="*" SortMemberPath="Language">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Language}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Condition" Width="*" SortMemberPath="SelectedCondition">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SelectedCondition}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Location" Width="*" SortMemberPath="SelectedLocationDisplayName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SelectedLocationDisplayName}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Comment" Width="*" SortMemberPath="Comment">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Comment}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Count" Width="*" SortMemberPath="CardsOwned">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CardsOwned}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Trade" Width="*" SortMemberPath="CardsForTrade">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CardsForTrade}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Sell price" Width="Auto" IsReadOnly="True">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DataContext.PricesVM.SellPriceHeader, ElementName=MyCollectionDataGrid}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource SellPriceDisplayConverter}">
                                        <Binding Path="SellPrice" />
                                        <Binding Path="SellPriceCurrency" />
                                        <Binding Path="DataContext.PricesVM.SellPriceDisplayCurrency" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                        <Binding Path="DataContext.PricesVM.UsdToEurRate" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                        <Binding Path="CardInCollectionPrice" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Price" Width="*" SortMemberPath="CardInCollectionPrice">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DataContext.PricesVM.RetailerPriceHeader, ElementName=MyCollectionDataGrid}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>                    
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CardInCollectionPrice}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDoubleClick">
                    <i:InvokeCommandAction Command="{Binding ModifyCollectionViewModel.EditSelectedCardsCommand}"
                                                  CommandParameter="{Binding SelectedItems, ElementName=MyCollectionDataGrid}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <DataGrid.InputBindings>
                <KeyBinding Key="Delete"
                                        Command="{Binding ModifyCollectionViewModel.DeleteSelectedCardsCommand}"
                                        CommandParameter="{Binding SelectedItems,RelativeSource={RelativeSource AncestorType=DataGrid}}" />
            </DataGrid.InputBindings>
            <DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Edit selected card(s)" Style="{StaticResource BelerenBold}"
                                          Command="{Binding ModifyCollectionViewModel.EditSelectedCardsCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="UPDATE selected card(s) - put ALL for TRADE" Style="{StaticResource BelerenBold}"
                                          Command="{Binding ModifyCollectionViewModel.PutAllForTradeCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="UPDATE selected card(s) - put NONE for TRADE" Style="{StaticResource BelerenBold}"
                                          Command="{Binding ModifyCollectionViewModel.SetNoneForTradeCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="DELETE card(s) from collection" Style="{StaticResource BelerenBold}"
                                          Command="{Binding ModifyCollectionViewModel.DeleteSelectedCardsCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="Set location..." Style="{StaticResource BelerenBold}" ItemsSource="{Binding ModifyCollectionViewModel.LocationMenuItems}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header" Value="{Binding Header}" />
                                <Setter Property="ItemsSource" Value="{Binding Children}" />
                                <Setter Property="Command" Value="{Binding DataContext.ModifyCollectionViewModel.SetLocationForSelectedCardsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Setter Property="CommandParameter">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource SetLocationCommandParameterConverter}">
                                            <Binding Path="PlacementTarget.SelectedItems" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                            <Binding Path="LocationId" />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    <MenuItem Header="With selected, update sell price..." Style="{StaticResource BelerenBold}">
                        <MenuItem Header="Match retail price" Style="{StaticResource BelerenBold}" 
                                  Command="{Binding DataContext.ModifyCollectionViewModel.MatchRetailPriceForSelectedCardsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.CommandParameter>
                                <MultiBinding Converter="{StaticResource MatchRetailPriceCommandParameterConverter}">
                                    <Binding Path="PlacementTarget.SelectedItems" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                    <Binding Path="PlacementTarget.DataContext.PricesVM.SellPriceDisplayCurrency" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                </MultiBinding>
                            </MenuItem.CommandParameter>
                        </MenuItem>
                        <MenuItem Header="Match retail price (-10%)" Style="{StaticResource BelerenBold}"
                                  Command="{Binding DataContext.ModifyCollectionViewModel.MatchRetailPriceMinusTenPercentForSelectedCardsCommand,
                            RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.CommandParameter>
                                <MultiBinding Converter="{StaticResource MatchRetailPriceCommandParameterConverter}">
                                    <Binding Path="PlacementTarget.SelectedItems" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                    <Binding Path="PlacementTarget.DataContext.PricesVM.SellPriceDisplayCurrency" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                </MultiBinding>
                            </MenuItem.CommandParameter>
                        </MenuItem>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>
</UserControl>
