<UserControl x:Class="CollectaMundo.Views.CardImageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CollectaMundo.Views"
             xmlns:viewmodels="clr-namespace:CollectaMundo.ViewModels" 
             d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Visibility="{Binding CardViewSectionVisibility}">
        <Label x:Name="ImagePromoLabel" Content="{Binding CardImageVM.ImagePromoType}" HorizontalAlignment="Left" VerticalAlignment="Top" Height="30" Width="250" Style="{StaticResource BelerenBold}"/>
        <Label x:Name="ImageSetLabel" Content="{Binding CardImageVM.ImageSet}" HorizontalAlignment="Left" VerticalAlignment="Top" Height="30" Width="250" Margin="0,35,0,0" Style="{StaticResource BelerenBold}"/>
        <Image x:Name="CardImage"
                       Source="{Binding CardImageVM.FrontImageSource}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,80,10,0"/>
        <Image x:Name="CardImageSecondary"
                       Source="{Binding CardImageVM.BackImageSource}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top" Margin="0,461,10,0"/>
    </Grid>
</UserControl>
