<UserControl x:Class="CollectaMundo.Views.ContentSection.CardLocations.CardLocationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:behaviors="clr-namespace:CollectaMundo.Presentation.Behaviors"
             xmlns:utilities="clr-namespace:CollectaMundo.ViewModels.Utilities" 
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=utilities:CardLocationViewModel}"
             d:Style="{StaticResource {x:Type UserControl}}"             
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Page title -->
            <RowDefinition Height="Auto"/>  <!-- Section header -->
            <RowDefinition Height="Auto"/>  <!-- Form for adding/editing location -->
            <RowDefinition Height="30"/>    <!-- Status message -->
            <RowDefinition Height="Auto"/>  <!-- Data grid -->
            <RowDefinition Height="Auto"/>  <!-- Additional content -->
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="Manage Card Locations" Style="{StaticResource BigHeaderLabelStyle}" />
        <Label Grid.Row="1" Content="{Binding ModeMessage}" Style="{StaticResource SmallHeaderLabelStyle}" />

        <StackPanel Grid.Row="2" Margin="0,16,0,0" Width="350" HorizontalAlignment="Center">

            <Label Content="Location name:" />
            <TextBox Text="{Binding LocationName, UpdateSourceTrigger=PropertyChanged}" 
                     IsEnabled="{Binding SaveEditEnabled}"
                     Margin="0,0,0,10" />
            
            <Label Content="Location type (storage or deck):" />
            <ComboBox ItemsSource="{Binding LocationTypes}" 
                      SelectedItem="{Binding SelectedLocationType, Mode=TwoWay}" 
                      IsEnabled="{Binding SaveEditEnabled}"
                      Margin="0,0,0,14" />

            <Grid Width="350">
                <Button Content="{Binding SubmitButtonText}"
                        Command="{Binding SubmitLocationCommand}"
                        IsEnabled="{Binding SaveEditEnabled}"
                        Width="100"
                        Height="20"
                        HorizontalAlignment="Left" />

                <Button Content="Cancel" Command="{Binding CancelEditCommand}"
                        Width="60"
                        Height="20"
                        HorizontalAlignment="Center"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}" />

                <Button Content="{Binding DeleteButtonText}"
                        Command="{Binding DeleteSelectedLocationsCommand}"
                        Width="100"
                        Height="20"
                        HorizontalAlignment="Right"
                        Visibility="{Binding HasSelectedLocations, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </StackPanel>

        <TextBlock Grid.Row="3" Margin="0,16,0,0" Text="{Binding StatusMessage}" Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVisibilityConverter}}" HorizontalAlignment="Center" TextWrapping="Wrap" />

        <DataGrid Grid.Row="4"
          ItemsSource="{Binding Locations}"
          SelectedItem="{Binding SelectedLocation, Mode=TwoWay}"
          behaviors:DataGridSelectedItemsBehavior.SyncedSelectedItems="{Binding SelectedLocations}"
          SelectionMode="Extended"
          SelectionUnit="FullRow"
          Style="{StaticResource DataGridBaseStyle}"
          Width="500"
          MinHeight="40"
          Margin="0,10,0,0"
          AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name"
                            Width="*"
                            Binding="{Binding Name}" />
                <DataGridTextColumn Header="Type"
                            Width="180"
                            Binding="{Binding Type}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
