<UserControl x:Class="CollectaMundo.Views.ContentSection.Import.ImportStep09_SummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vmsteps="clr-namespace:CollectaMundo.ViewModels.Import.ImportSteps"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vmsteps:ImportStep09_SummaryViewModel}"
             d:Style="{StaticResource {x:Type UserControl}}"
             d:DesignHeight="600"
             d:DesignWidth="800">

    <Grid Visibility="{Binding StepContentVisibility}"
      HorizontalAlignment="Center"
      Width="550">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Totals -->
            <RowDefinition Height="Auto"/>  <!-- Field mappings -->
            <RowDefinition Height="Auto"/>  <!-- Value mappings -->
            <RowDefinition Height="Auto"/>  <!-- Unimportable header -->
            <RowDefinition Height="*"/>     <!-- Unimportable table -->
        </Grid.RowDefinitions>

        <!-- ================= TOTAL COUNTS ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="Number of individual cards that will be added:"
                   Style="{StaticResource BelerenBold}" />
            <TextBlock Grid.Row="0" Grid.Column="1"
                   Text="{Binding Summary.ReadyToImportCount}"
                   Margin="10,0,0,0"/>

            <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="Total count of cards added to collection:"
                   Style="{StaticResource BelerenBold}" />
            <TextBlock Grid.Row="1" Grid.Column="1"
                   Text="{Binding Summary.TotalCardsToAdd}"
                   Margin="10,0,0,0"/>

            <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="Number of cards not possible to import:"
                   Style="{StaticResource BelerenBold}" />
            <TextBlock Grid.Row="2" Grid.Column="1"
                   Text="{Binding Summary.UnableToImportCount}"
                   Margin="10,0,0,0"/>
        </Grid>

        <!-- ================= FIELD MAPPINGS ================= -->
        <GroupBox Grid.Row="1" Header="Field mappings" Margin="0,0,0,15">
            <ItemsControl ItemsSource="{Binding Summary.FieldMappings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="{Binding Field}"
                                   FontWeight="Bold"/>
                            <TextBlock Text=" → " Margin="6,0"/>
                            <TextBlock Text="{Binding CsvHeader}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </GroupBox>

        <!-- ================= VALUE MAPPINGS ================= -->
        <GroupBox Grid.Row="2" Header="Value mappings" Margin="0,0,0,15">
            <DataGrid ItemsSource="{Binding Summary.ValueMappings}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="120"/>
                    <DataGridTextColumn Header="CSV value" Binding="{Binding CsvValue}" Width="*"/>
                    <DataGridTextColumn Header="Mapped value" Binding="{Binding MappedValue}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- ================= UNIMPORTABLE HEADER ================= -->
        <TextBlock Grid.Row="3"
                   Text="Unable to import the following cards:"
                   FontSize="16"
                   Style="{StaticResource BelerenBold}"
                   Visibility="{Binding Summary.UnableToImportCount, Converter={StaticResource CountToVisibilityConverter}}"
                   Margin="0,0,0,10"/>

        <!-- ================= UNIMPORTABLE ITEMS TABLE ================= -->
        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding Summary.UnimportableItems}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  Visibility="{Binding Summary.UnableToImportCount, Converter={StaticResource CountToVisibilityConverter}}"
                  Margin="0,10,0,0"
                  MaxHeight="300"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Card Name" Binding="{Binding CardName}" Width="*"/>
                <DataGridTextColumn Header="Set Name" Binding="{Binding SetName}" Width="*"/>
                <DataGridTextColumn Header="Set Code" Binding="{Binding SetCode}" Width="*"/>
                <DataGridTextColumn Header="Warning" Binding="{Binding WarningText}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
