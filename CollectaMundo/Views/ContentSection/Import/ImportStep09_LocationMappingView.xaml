<UserControl x:Class="CollectaMundo.Views.ContentSection.Import.ImportStep09_LocationMappingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             xmlns:vmsteps="clr-namespace:CollectaMundo.ViewModels.Import.ImportSteps"             
             d:DataContext="{d:DesignInstance vmsteps:ImportStep09_LocationMappingViewModel}"
             d:Style="{StaticResource {x:Type UserControl}}"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Visibility="{Binding IsStepContentVisible, Converter={StaticResource BoolToVisibilityConverter}}" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <!-- Explainer -->
            <RowDefinition Height="Auto"/>
            <!-- Listview -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <FlowDocumentScrollViewer Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Center">
            <FlowDocument>
                <Paragraph>
                    Left column are the locations found in the import file. Please map them to available locations in the database.
                </Paragraph>
                <Paragraph>
                    Click "Proceed" to import any blank locations as blank (no location).
                </Paragraph>
                <Paragraph>
                    Click "Create missing locations" to create any missing locations as new locations during the import process. All new locations will be created with the same name as the location found in the import file and be of the type "storage". Location type (e.g. to "Deck") can be changed in Utilities section.
                </Paragraph>
            </FlowDocument>
        </FlowDocumentScrollViewer>
        <ListView Grid.Row="1" ItemsSource="{Binding LocationMappings}" HorizontalAlignment="Center" VerticalAlignment="Top">
            <ListView.View>
                <GridView>
                    <!-- LEFT COLUMN: CsvValue - just show the string -->
                    <GridViewColumn Header="Locations found in import file" Width="200">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CsvValue}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- RIGHT COLUMN: CardSetValues - dropdown of selectable values -->
                    <GridViewColumn Header="Available locations in database" Width="180">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding CardSetValues}"
                                  SelectedItem="{Binding SelectedCardSetValue, Mode=TwoWay}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- RESET BUTTON -->
                    <GridViewColumn Header="Reset" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="   Clear   "
                                Command="{Binding DataContext.ClearSelectedMappingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
