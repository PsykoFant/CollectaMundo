<UserControl x:Class="CollectaMundo.Views.ContentSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"             
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:views="clr-namespace:CollectaMundo.Views"
             xmlns:behaviors="clr-namespace:CollectaMundo.Presentation.Behaviors"
             xmlns:viewmodels="clr-namespace:CollectaMundo.ViewModels"
             xmlns:presentation="clr-namespace:CollectaMundo.Presentation"
             xmlns:converters="clr-namespace:CollectaMundo.Presentation.Converters"
             xmlns:validation="clr-namespace:CollectaMundo.Presentation.Validation"
             d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Visibility="{Binding ContentSectionVisibility}">
        <Image Source="/Resources/Images/Logo.png"
                       Stretch="Fill"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Center"
                       Height="170"
                       Width="170"
                       RenderTransformOrigin="0.5,0.5"
                       Margin="0,70,0,0"
                       Opacity="0.8" 
                       Visibility="{Binding MiniLogoVisibility}"/>
        <ScrollViewer HorizontalAlignment="Center" Margin="0,240,0,0" VerticalAlignment="Top" Height="40" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Visibility="{Binding MiniLogoVisibility}">
            <TextBlock HorizontalAlignment="Center" Margin="0,0,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Text="{Binding FilterVM.FilterSummary}"/>
        </ScrollViewer>
        <!-- Search and Filter -->
        <Grid Visibility="{Binding DataContext.Main.CurrentPage,RelativeSource={RelativeSource AncestorType=Window}, 
                    Converter={StaticResource PageToVisibilityConverter},
                    ConverterParameter={x:Static presentation:Page.SearchAndFilter}}" d:IsHidden="True">
            <Label Content="Search and Filter Cards" Style="{StaticResource MediumHeaderLabelStyle}"/>
            <Label Visibility="{Binding AddCardsVM.StatusVisibility,Converter={StaticResource InverseVisibility}}"
                       HorizontalAlignment="Left" Margin="0,25,0,0" VerticalAlignment="Top" Height="30" >
                <Label.Content>
                    <MultiBinding Converter="{StaticResource CountToSummaryConverter}">
                        <Binding Path="AllCardsVM.FilteredCount"/>
                        <Binding Path="AllCardsVM.TotalCount"/>
                    </MultiBinding>
                </Label.Content>
            </Label>
            <Button Content="Submit these cards to my collection" HorizontalAlignment="Right" Margin="0,45,0,0" VerticalAlignment="Top" Width="200" Height="20" 
                            Visibility="{Binding AddCardsVM.CollectionEditVisibility}"
                            Command="{Binding AddCardsVM.SubmitNewCardsCommand}" />
            <Button Content="Clear cards without submitting"
                        HorizontalAlignment="Right" Margin="0,45,210,0" VerticalAlignment="Top"
                        Width="200" Height="20"
                        Visibility="{Binding AddCardsVM.CollectionEditVisibility}"
                        Command="{Binding AddCardsVM.ClearCardsToAddCommand}" />
            <Button Content="Add selected cards to my collection"
                        HorizontalAlignment="Right" Margin="0,255,0,0" VerticalAlignment="Top"
                        Width="200" Height="20"
                        Visibility="{Binding ElementName=AllCardsDataGrid, Path=SelectedItems.Count, Converter={StaticResource CountToVisibilityConverter}}"
                        Command="{Binding AddCardsVM.AddSelectedCardsCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=AllCardsDataGrid}" />
            <ScrollViewer HorizontalAlignment="Left" Margin="0,40,0,0" VerticalAlignment="Top" Height="187" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Top" Text="{Binding AddCardsVM.StatusMessage}"/>
            </ScrollViewer>
            <!--Cards to add listview-->
            <ListView DataContext="{Binding AddCardsVM}"
                                  ItemsSource="{Binding CardsToAdd}"
                                  Visibility="{Binding CollectionEditVisibility}"                          
                                  behaviors:ListViewColumnRefreshBehavior.RefreshTrigger="{Binding RefreshColumnsTrigger, Mode=OneWay}"                          
                                  Margin="0,70,0,0" VerticalAlignment="Top" Height="170">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Card Name" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Set" DisplayMemberBinding="{Binding SetName}"/>
                        <GridViewColumn Header="Condition">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding Conditions}"
                                                          SelectedItem="{Binding SelectedCondition, UpdateSourceTrigger=PropertyChanged}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="SelectionChanged">
                                                <i:InvokeCommandAction Command="{Binding DataContext.RefreshColumnsCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </ComboBox>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Finish">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding AvailableFinishes}" 
                                                          SelectedItem="{Binding SelectedFinish, UpdateSourceTrigger=PropertyChanged}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="SelectionChanged">
                                                <i:InvokeCommandAction Command="{Binding DataContext.RefreshColumnsCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </ComboBox>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Language">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding OtherLanguages}" 
                                                          SelectedItem="{Binding Language, UpdateSourceTrigger=PropertyChanged}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="SelectionChanged">
                                                <i:InvokeCommandAction Command="{Binding DataContext.RefreshColumnsCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </ComboBox>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="+">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="+" Width="15" Background="#FFFBF7B4"
                                                    Command="{Binding DataContext.IncrementCountCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListViewItem}}, Path=DataContext}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Count">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox HorizontalAlignment="Center" Background="White">
                                        <TextBox.Text>
                                            <Binding Path="CardsOwned" Mode="TwoWay" UpdateSourceTrigger="Explicit" ValidatesOnDataErrors="True" NotifyOnValidationError="True">
                                                <Binding.ValidationRules>
                                                    <validation:IntegerValidationRule />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Behaviors>
                                            <behaviors:DelayedUpdateBehavior Delay="500"/>
                                            <behaviors:NumericValidationBehavior />
                                        </i:Interaction.Behaviors>
                                    </TextBox>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="-">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="-" Width="15" Background="#FFFBF7B4"
                                                    Command="{Binding DataContext.DecrementCountCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListViewItem}}, Path=DataContext}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="+">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="+" Width="15" Background="#FFFBF7B4"
                                                    Command="{Binding DataContext.IncrementTradeCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListViewItem}}, Path=DataContext}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Trade">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox HorizontalAlignment="Center" Background="White">
                                        <TextBox.Text>
                                            <Binding Path="CardsForTrade" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"
                                                                 ValidatesOnDataErrors="True" NotifyOnValidationError="True">
                                                <Binding.ValidationRules>
                                                    <validation:IntegerValidationRule />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Behaviors>
                                            <behaviors:NumericValidationBehavior />
                                        </i:Interaction.Behaviors>
                                    </TextBox>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="-">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="-" Width="15" Background="#FFFBF7B4"
                                                    Command="{Binding DataContext.DecrementTradeCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListViewItem}}, Path=DataContext}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            <!--The main card view datagrid-->
            <DataGrid x:Name="AllCardsDataGrid"
                                  ItemsSource="{Binding AllCardsVM.FilteredCards, NotifyOnTargetUpdated=True}"
                                  Margin="0,280,0,0"
                                  AutoGenerateColumns="False"
                                  SelectedItem="{Binding CardImageVM.SelectedCard, Mode=TwoWay}"
                                  ScrollViewer.CanContentScroll="True"
                                  EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  CanUserAddRows="False"
                                  CanUserSortColumns="True"
                                  HorizontalAlignment="Stretch"
                                  IsReadOnly="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  behaviors:DataGridPersistSortBehavior.Enable="True"
                                  behaviors:DataGridColumnResizerBehavior.EnableAutoResize="True"
                                  behaviors:DataGridColumnResizerBehavior.DataGridIndex="0"
                                  behaviors:DataGridClearSelectionBehavior.ClearSelectionTrigger="{Binding AddCardsVM.ClearSelectionTrigger, Mode=TwoWay}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction 
                                    Command="{Binding AddCardsVM.AddSelectedCardsCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=AllCardsDataGrid}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="Name">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <Grid DataContext="{Binding DataContext.Main.FilterVM.Filters[Name],RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="Name" VerticalAlignment="Center" Grid.Column="0"/>
                                    <ComboBox IsTextSearchEnabled="False"
                                              Grid.Column="1"
                                              HorizontalAlignment="Stretch"
                                              Height="20"
                                              IsEditable="True"
                                              Width="{Binding DataContext.Main.ColumnWidths[0][0], RelativeSource={RelativeSource AncestorType=Window}}"
                                              ItemsSource="{Binding FilteredOptions}"
                                              DisplayMemberPath="OptionName"
                                              Text="{Binding FreetextSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="SelectionChanged">
                                                <i:InvokeCommandAction
                                                            Command="{Binding ComboBoxSelectionChangedCommand}"
                                                            CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                        <i:Interaction.Behaviors>
                                            <behaviors:ComboBoxUnselector ClearTrigger="{Binding ClearComboBoxSelectionTrigger}" />
                                        </i:Interaction.Behaviors>
                                        <ComboBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ComboBox.ItemsPanel>
                                    </ComboBox>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Set" Width="*" SortMemberPath="SetName">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <Grid DataContext="{Binding DataContext.Main.FilterVM.Filters[SetName],RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="Set" VerticalAlignment="Center" Grid.Column="0"/>
                                    <ComboBox IsTextSearchEnabled="False"
                                              Grid.Column="1"
                                              HorizontalAlignment="Stretch"
                                              Height="20"
                                              IsEditable="True"
                                              Width="{Binding DataContext.Main.ColumnWidths[0][1], RelativeSource={RelativeSource AncestorType=Window}}"
                                              ItemsSource="{Binding FilteredOptions}"
                                              DisplayMemberPath="OptionName"
                                              Text="{Binding FreetextSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="SelectionChanged">
                                                <i:InvokeCommandAction
                                                            Command="{Binding ComboBoxSelectionChangedCommand}"
                                                            CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                        <i:Interaction.Behaviors>
                                            <behaviors:ComboBoxUnselector ClearTrigger="{Binding ClearComboBoxSelectionTrigger}" />
                                        </i:Interaction.Behaviors>
                                        <ComboBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ComboBox.ItemsPanel>
                                    </ComboBox>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SetName}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Icon" IsReadOnly="True" Width="Auto" SortMemberPath="ReleaseDate">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding KeyRuneImage}" Width="20" Height="20" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Mana Cost" IsReadOnly="True" Width="Auto" SortMemberPath="ManaValue">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding ManaCostImage}" Height="20" HorizontalAlignment="Right"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Card Types" Width="*" SortMemberPath="Type">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Type}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Finishes" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Finishes}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn SortMemberPath="NormalPrice" Width="*">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DataContext.Main.PricesVM.PriceHeader, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding NormalPrice}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn SortMemberPath="FoilPrice" Width="*">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DataContext.Main.PricesVM.FoilPriceHeader, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FoilPrice}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn SortMemberPath="EtchedPrice" Width="*">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DataContext.Main.PricesVM.EtchedPriceHeader, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding EtchedPrice}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Add selected card(s) to Collection"
                                              Command="{Binding AddCardsVM.AddSelectedCardsCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Style="{StaticResource BelerenBold}" />
                        <MenuItem Header="Add selected card(s) with DEFAULT values to Collection" 
                                              Command="{Binding AddCardsVM.SubmitNewCardsWithDefaultsCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Style="{StaticResource BelerenBold}"/>
                        <MenuItem Header="">
                            <MenuItem.Template>
                                <ControlTemplate>
                                    <Label Content="Default values are:" Margin="30,0,0,0"/>
                                </ControlTemplate>
                            </MenuItem.Template>
                        </MenuItem>
                        <MenuItem Header="">
                            <MenuItem.Template>
                                <ControlTemplate>
                                    <Label Content=" - Condition: Near Mint" Margin="30,0,0,0"/>
                                </ControlTemplate>
                            </MenuItem.Template>
                        </MenuItem>
                        <MenuItem Header="">
                            <MenuItem.Template>
                                <ControlTemplate>
                                    <Label Content=" - Language: English" Margin="30,0,0,0"/>
                                </ControlTemplate>
                            </MenuItem.Template>
                        </MenuItem>
                        <MenuItem Header="">
                            <MenuItem.Template>
                                <ControlTemplate>
                                    <Label Content=" - Finish: nonfoil" Margin="30,0,0,0"/>
                                </ControlTemplate>
                            </MenuItem.Template>
                        </MenuItem>
                        <MenuItem Header="">
                            <MenuItem.Template>
                                <ControlTemplate>
                                    <Label Content=" - Count: 1" Margin="30,0,0,0"/>
                                </ControlTemplate>
                            </MenuItem.Template>
                        </MenuItem>
                        <MenuItem Header="">
                            <MenuItem.Template>
                                <ControlTemplate>
                                    <Label Content=" - Trade: 0" Margin="30,0,0,0"/>
                                </ControlTemplate>
                            </MenuItem.Template>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </Grid>
        <!-- My Collection -->
        <Grid Visibility="{Binding DataContext.Main.CurrentPage,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource PageToVisibilityConverter},ConverterParameter={x:Static presentation:Page.MyCollection}}">
            <Label Content="My Collection" Style="{StaticResource MediumHeaderLabelStyle}" />
            <Label HorizontalAlignment="Left" Margin="0,25,0,0" VerticalAlignment="Top" Height="30" Visibility="{Binding EditCardsVM.StatusVisibility,Converter={StaticResource InverseVisibility}}">
                <Label.Content>
                    <MultiBinding Converter="{StaticResource CountToSummaryConverter}">
                        <Binding Path="MyCollectionVM.FilteredCount"/>
                        <Binding Path="MyCollectionVM.TotalCount"/>
                    </MultiBinding>
                </Label.Content>
            </Label>
            <Button Content="Update selected cards" HorizontalAlignment="Right" Margin="0,45,0,0" VerticalAlignment="Top" Width="200" Height="20"
                            Visibility="{Binding EditCardsVM.CollectionEditVisibility}"
                            Command="{Binding EditCardsVM.SubmitCardEditsCommand}" />
            <Button Content="Clear cards without submitting"
                            HorizontalAlignment="Right" Margin="0,45,210,0" VerticalAlignment="Top"
                            Width="200" Height="20"
                            Visibility="{Binding EditCardsVM.CollectionEditVisibility}"
                            Command="{Binding EditCardsVM.ClearCardsToAddCommand}" />
            <Button Content="Edit selected cards"
                        HorizontalAlignment="Right" Margin="0,255,0,0" VerticalAlignment="Top"
                        Width="120" Height="20"
                        Visibility="{Binding ElementName=MyCollectionDataGrid, Path=SelectedItems.Count, Converter={StaticResource CountToVisibilityConverter}}"
                        Command="{Binding EditCardsVM.EditSelectedCardsCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=MyCollectionDataGrid}" />
            <ScrollViewer HorizontalAlignment="Left" Margin="0,40,0,0" VerticalAlignment="Top" Height="187" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding EditCardsVM.StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Top" />
            </ScrollViewer>

            <!--Cards to edit-->
            <ListView DataContext="{Binding EditCardsVM}"
                              ItemsSource="{Binding CardsToAdd}"
                              Visibility="{Binding CollectionEditVisibility}"                          
                              behaviors:ListViewColumnRefreshBehavior.RefreshTrigger="{Binding RefreshColumnsTrigger, Mode=OneWay}"    
                              Margin="0,70,0,0" VerticalAlignment="Top" Height="170">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Card Name" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Set" DisplayMemberBinding="{Binding SetName}"/>
                        <GridViewColumn Header="Condition">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding Conditions}"
                                                      SelectedItem="{Binding SelectedCondition, UpdateSourceTrigger=PropertyChanged}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="SelectionChanged">
                                                <i:InvokeCommandAction Command="{Binding DataContext.RefreshColumnsCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </ComboBox>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Finish">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding AvailableFinishes}" 
                                                      SelectedItem="{Binding SelectedFinish, UpdateSourceTrigger=PropertyChanged}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="SelectionChanged">
                                                <i:InvokeCommandAction Command="{Binding DataContext.RefreshColumnsCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </ComboBox>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Language">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding OtherLanguages}" 
                                                      SelectedItem="{Binding Language, UpdateSourceTrigger=PropertyChanged}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="SelectionChanged">
                                                <i:InvokeCommandAction Command="{Binding DataContext.RefreshColumnsCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </ComboBox>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="+">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="+" Width="15" Background="#FFFBF7B4"
                                                Command="{Binding DataContext.IncrementCountCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListViewItem}}, Path=DataContext}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Count">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox HorizontalAlignment="Center" Background="White">
                                        <TextBox.Text>
                                            <Binding Path="CardsOwned" Mode="TwoWay" UpdateSourceTrigger="Explicit" ValidatesOnDataErrors="True" NotifyOnValidationError="True">
                                                <Binding.ValidationRules>
                                                    <validation:IntegerValidationRule />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Behaviors>
                                            <behaviors:DelayedUpdateBehavior Delay="500"/>
                                            <behaviors:NumericValidationBehavior />
                                        </i:Interaction.Behaviors>
                                    </TextBox>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="-">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="-" Width="15" Background="#FFFBF7B4"
                                                Command="{Binding DataContext.DecrementCountCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListViewItem}}, Path=DataContext}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="+">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="+" Width="15" Background="#FFFBF7B4"
                                                Command="{Binding DataContext.IncrementTradeCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListViewItem}}, Path=DataContext}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Trade">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox HorizontalAlignment="Center" Background="White">
                                        <TextBox.Text>
                                            <Binding Path="CardsForTrade" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"
                                                             ValidatesOnDataErrors="True" NotifyOnValidationError="True">
                                                <Binding.ValidationRules>
                                                    <validation:IntegerValidationRule />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Behaviors>
                                            <behaviors:NumericValidationBehavior />
                                        </i:Interaction.Behaviors>
                                    </TextBox>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="-">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="-" Width="15" Background="#FFFBF7B4"
                                                Command="{Binding DataContext.DecrementTradeCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListViewItem}}, Path=DataContext}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            <!--The my collection datagrid-->
            <DataGrid x:Name="MyCollectionDataGrid"
                              ItemsSource="{Binding MyCollectionVM.FilteredCards, NotifyOnTargetUpdated=True}"
                              Margin="0,280,0,0"
                              AutoGenerateColumns="False"
                              SelectedItem="{Binding CardImageVM.SelectedCard, Mode=TwoWay}"
                              ScrollViewer.CanContentScroll="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              CanUserAddRows="False"
                              CanUserSortColumns="True"
                              HorizontalAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              behaviors:DataGridPersistSortBehavior.Enable="True"
                              behaviors:DataGridColumnResizerBehavior.EnableAutoResize="True"
                              behaviors:DataGridColumnResizerBehavior.DataGridIndex="1"                              
                              behaviors:DataGridColumnResizerBehavior.UpdateOnToken="{Binding DataContext.Main.MyCollectionResizeToken, RelativeSource={RelativeSource AncestorType=Window}}"
                              behaviors:DataGridClearSelectionBehavior.ClearSelectionTrigger="{Binding EditCardsVM.ClearSelectionTrigger, Mode=TwoWay}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction Command="{Binding EditCardsVM.EditSelectedCardsCommand}"
                                                  CommandParameter="{Binding SelectedItems, ElementName=MyCollectionDataGrid}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <DataGrid.InputBindings>
                    <KeyBinding Key="Delete"
                                        Command="{Binding EditCardsVM.DeleteSelectedCardsCommand}"
                                        CommandParameter="{Binding SelectedItems,RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="Name">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <Grid DataContext="{Binding DataContext.Main.FilterVM.Filters[Name],RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="Name" VerticalAlignment="Center" Grid.Column="0"/>
                                    <ComboBox IsTextSearchEnabled="False"
                                              Grid.Column="1"
                                              HorizontalAlignment="Stretch"
                                              Height="20"
                                              IsEditable="True"
                                              Width="{Binding DataContext.Main.ColumnWidths[1][0], RelativeSource={RelativeSource AncestorType=Window}}"
                                              ItemsSource="{Binding FilteredOptions}"
                                              DisplayMemberPath="OptionName"
                                              Text="{Binding FreetextSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="SelectionChanged">
                                                <i:InvokeCommandAction
                                                            Command="{Binding ComboBoxSelectionChangedCommand}"
                                                            CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                        <i:Interaction.Behaviors>
                                            <behaviors:ComboBoxUnselector ClearTrigger="{Binding ClearComboBoxSelectionTrigger}" />
                                        </i:Interaction.Behaviors>
                                        <ComboBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ComboBox.ItemsPanel>
                                    </ComboBox>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Set" Width="*" SortMemberPath="SetName">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <Grid DataContext="{Binding DataContext.Main.FilterVM.Filters[SetName],RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="Set" VerticalAlignment="Center" Grid.Column="0"/>
                                    <ComboBox IsTextSearchEnabled="False"
                                              Grid.Column="1"
                                              HorizontalAlignment="Stretch"
                                              Height="20"
                                              IsEditable="True"
                                              Width="{Binding DataContext.Main.ColumnWidths[1][1], RelativeSource={RelativeSource AncestorType=Window}}"
                                              ItemsSource="{Binding FilteredOptions}"
                                              DisplayMemberPath="OptionName"
                                              Text="{Binding FreetextSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="SelectionChanged">
                                                <i:InvokeCommandAction
                                                            Command="{Binding ComboBoxSelectionChangedCommand}"
                                                            CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                        <i:Interaction.Behaviors>
                                            <behaviors:ComboBoxUnselector ClearTrigger="{Binding ClearComboBoxSelectionTrigger}" />
                                        </i:Interaction.Behaviors>
                                        <ComboBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ComboBox.ItemsPanel>
                                    </ComboBox>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SetName}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Icon" IsReadOnly="True" Width="Auto" SortMemberPath="ReleaseDate">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding KeyRuneImage}" Width="20" Height="20" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Mana Cost" Width="Auto" IsReadOnly="True" SortMemberPath="ManaValue">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding ManaCostImage}" Height="20" HorizontalAlignment="Right"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Card Types" Width="*" SortMemberPath="Type">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Type}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Finish" Width="*" SortMemberPath="SelectedFinish">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SelectedFinish}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Language" Width="*" SortMemberPath="Language">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Language}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Condition" Width="*" SortMemberPath="SelectedCondition">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SelectedCondition}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Count" Width="*" SortMemberPath="CardsOwned">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CardsOwned}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Trade" Width="*" SortMemberPath="CardsForTrade">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CardsForTrade}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Price" Width="*" SortMemberPath="CardInCollectionPrice">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CardInCollectionPrice}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Edit selected card(s)" Style="{StaticResource BelerenBold}"
                                          Command="{Binding EditCardsVM.AddSelectedCardsCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="UPDATE selected card(s) - put ALL for TRADE" Style="{StaticResource BelerenBold}"
                                          Command="{Binding EditCardsVM.PutAllForTradeCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="UPDATE selected card(s) - put NONE for TRADE" Style="{StaticResource BelerenBold}"
                                          Command="{Binding EditCardsVM.SetNoneForTradeCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="DELETE card(s) from collection" Style="{StaticResource BelerenBold}"
                                          Command="{Binding EditCardsVM.DeleteSelectedCardsCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </Grid>
        <Grid x:Name="GridDecks" d:IsHidden="True"
                      Visibility="{Binding DataContext.Main.CurrentPage,RelativeSource={RelativeSource AncestorType=Window},
                   Converter={StaticResource PageToVisibilityConverter},
                   ConverterParameter={x:Static presentation:Page.Decks}}">
        </Grid>
        <Grid x:Name="GridUtilitiesSection" d:IsHidden="True"
                      Visibility="{Binding DataContext.Main.CurrentPage,RelativeSource={RelativeSource AncestorType=Window},
                    Converter={StaticResource PageToVisibilityConverter},
                    ConverterParameter={x:Static presentation:Page.Utilities}}">
            <Label Content="Utilities" Style="{StaticResource MediumHeaderLabelStyle}" />
            <Image x:Name="Inspiredtinkering" Margin="0,200,0,0" Source="/Resources/Images/inspired-tinkering-183.png" HorizontalAlignment="Center" VerticalAlignment="Top" Width="600" Opacity="0.698"/>
        </Grid>
        <!-- Status window -->
        <views.Shared:StatusOverlay DataContext="{Binding DataContext.StatusOverlay, RelativeSource={RelativeSource AncestorType=Window}}" d:IsHidden="True"/>
        <views.Import:ImportOverlay DataContext="{Binding DataContext.ImportOverlay, RelativeSource={RelativeSource AncestorType=Window}}" d:IsHidden="True"/>
    </Grid>
</UserControl>
