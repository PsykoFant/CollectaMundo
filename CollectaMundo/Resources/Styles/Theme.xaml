<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <LinearGradientBrush x:Key="CollectaMundoBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFBF7B4"/>
        <GradientStop Color="White" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="CollectaMundoForeground" Color="#FF2B2518"/>
    <SolidColorBrush x:Key="CollectaMundoBorder" Color="#FF8F8150"/>
    <SolidColorBrush x:Key="DragAddBrush" Color="#FF3F7D44"/>
    <SolidColorBrush x:Key="DragMoveBrush" Color="#FF3E6385"/>
    <SolidColorBrush x:Key="DragDeleteBrush" Color="#FFA33A32"/>
    <SolidColorBrush x:Key="DragNoOpBrush" Color="#FF77736A"/>

    <FontFamily x:Key="CollectaMundoFont">pack://application:,,,/Resources/Fonts/#MPlantin</FontFamily>
    <FontFamily x:Key="CollectaMundoHeaderFont">pack://application:,,,/Resources/Fonts/#Beleren2016</FontFamily>
</ResourceDictionary>
