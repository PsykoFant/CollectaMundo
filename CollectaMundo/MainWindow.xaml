                            <ComboBox x:Name="NewDeckFormatComboBox" Width="200" Margin="160,80,0,0" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" />
                            <Button x:Name="SubmitNewDeckButton" Width="100" Content="Submit new deck" Height="20" Margin="365,80,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Click="SubmitNewDeckButton_Click" />
                            <Button x:Name="CancelNewDeckButton" Content="Cancel" Height="20" Margin="470,80,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="45" Click="CancelNewDeckButton_Click"/>
                        </Grid>
                        <ListView x:Name="MyDecksListView" HorizontalAlignment="Center" Margin="0,120,0,0" SelectionMode="Single" Width="600" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OpenAndEditDeck">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Deck Name" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DeckName}" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Description" Width="240">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Target Format" Width="140">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TargetFormat}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Action" Width="45">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="&#xE104;" FontFamily="Segoe MDL2 Assets" ToolTip="Edit deck" Margin="0,0,4,0" VerticalAlignment="Center" HorizontalAlignment="Center" Click="OpenAndEditDeck"/>
                                                    <Button Content="&#xE107;" FontFamily="Segoe MDL2 Assets" ToolTip="Delete" VerticalAlignment="Center" HorizontalAlignment="Center" Click="DeleteDeckButton_Click"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                    <Grid x:Name="GridDeckEditor" Grid.Row="1" VerticalAlignment="Top" Visibility="Hidden">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="100"/>
                            <RowDefinition Height="150"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" HorizontalAlignment="Center" Margin="0,-2,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,300,0" VerticalAlignment="Top" >
                                <TextBox x:Name="DeckNameTextBox" TextWrapping="Wrap" Text="Deck name" Width="300" FontSize="18" Background="{x:Null}" BorderBrush="{x:Null}" Height="25" IsReadOnly="True" MouseDoubleClick="EditDeckInfoButton_Click" KeyDown="DeckInfoTextBox_KeyDown"/>
                                <Button x:Name="EditDeckNameButton" Content="&#xE104;" FontFamily="Segoe MDL2 Assets" ToolTip="Edit deck name" VerticalAlignment="Center" HorizontalAlignment="Center" Click="EditDeckInfoButton_Click"/>
                                <Button x:Name="SaveDeckNameButton" Content="&#xE105;" FontFamily="Segoe MDL2 Assets" ToolTip="Save deck name" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Hidden" Click="SaveDeckInfoButton_Click"/>
                                <Button x:Name="CancelDeckNameEditButton" Content="&#xE10A;" FontFamily="Segoe MDL2 Assets" ToolTip="Cancel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Hidden" Click="CancelDeckEditButton_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,300,0" VerticalAlignment="Top" >
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Height="30" Width="300" HorizontalAlignment="Left">
                                    <TextBox x:Name="DeckDescriptionTextBox" TextWrapping="Wrap" Text="Deck description" VerticalAlignment="Top" Width="280" Background="{x:Null}" BorderBrush="{x:Null}" IsReadOnly="True" MouseDoubleClick="EditDeckInfoButton_Click" KeyDown="DeckInfoTextBox_KeyDown" HorizontalAlignment="Left"/>
                                </ScrollViewer>
                                <Button x:Name="EditDeckDescriptionButton" Content="&#xE104;" FontFamily="Segoe MDL2 Assets" ToolTip="Edit deck description" VerticalAlignment="Center" Click="EditDeckInfoButton_Click"/>
                                <Button x:Name="SaveDeckDescriptionButton" Content="&#xE105;" FontFamily="Segoe MDL2 Assets" ToolTip="Save deck description" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Hidden" Click="SaveDeckInfoButton_Click"/>
                                <Button x:Name="CancelDeckDescriptionEditButton" Content="&#xE10A;" FontFamily="Segoe MDL2 Assets" ToolTip="Cancel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Hidden" Click="CancelDeckEditButton_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,60,300,0" VerticalAlignment="Top" >
                                <TextBox x:Name="DeckFormatTextBox" TextWrapping="Wrap" Text="Deck format" VerticalAlignment="Top" Width="300" Background="{x:Null}" BorderBrush="{x:Null}" IsReadOnly="True" MouseDoubleClick="EditDeckInfoButton_Click"/>
                                <ComboBox x:Name="ExistingDeckFormatComboBox" Height="20" VerticalAlignment="Top" Width="300" Visibility="Collapsed"/>
                                <Button x:Name="EditDeckFormatButton" Content="&#xE104;" FontFamily="Segoe MDL2 Assets" ToolTip="Edit target format" VerticalAlignment="Center" Click="EditDeckInfoButton_Click"/>
                                <Button x:Name="SaveDeckFormatButton" Content="&#xE105;" FontFamily="Segoe MDL2 Assets" ToolTip="Save target format" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Hidden" Click="SaveDeckInfoButton_Click"/>
                                <Button x:Name="CancelDeckFormatEditButton" Content="&#xE10A;" FontFamily="Segoe MDL2 Assets" ToolTip="Cancel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Hidden" Click="CancelDeckEditButton_Click"/>
                            </StackPanel>
                            <Button x:Name="BackToDeckOverviewButton" Content="Back" HorizontalAlignment="Right" VerticalAlignment="Top" Click="BackToDeckOverviewButton_Click" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <DataGrid x:Name="AllCardsForDecksDataGrid"
                                      ItemsSource="{Binding AllCardsForDecksVM.FilteredCards}"
                                      AutoGenerateColumns="False"
                                      MouseDoubleClick="AddCardToDeck"
                                      ScrollViewer.CanContentScroll="True"
                                      EnableColumnVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      CanUserAddRows="False"
                                      CanUserSortColumns="True"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,129,0,-129"
                                      behaviors:DataGridColumnResizerBehavior.EnableAutoResize="True"
                                      behaviors:DataGridColumnResizerBehavior.DataGridIndex="2">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="Name">
                                        <DataGridTemplateColumn.HeaderTemplate>
                                            <DataTemplate>
                                                <Grid DataContext="{Binding DataContext.Main.FilterVM.Filters[Name],RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Label Content="Name" VerticalAlignment="Center" Grid.Column="0"/>
                                                    <ComboBox IsTextSearchEnabled="False"
                                                      Grid.Column="1"
                                                      HorizontalAlignment="Stretch"
                                                      Height="20"
                                                      IsEditable="True"
                                                      Width="{Binding DataContext.Main.ColumnWidths[2][0], RelativeSource={RelativeSource AncestorType=Window}}"
                                                      ItemsSource="{Binding FilteredOptions}"
                                                      DisplayMemberPath="OptionName"
                                                      Text="{Binding FreetextSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="SelectionChanged">
                                                                <i:InvokeCommandAction
                                                            Command="{Binding ComboBoxSelectionChangedCommand}"
                                                            CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                            </i:EventTrigger>
                                                        </i:Interaction.Triggers>
                                                        <i:Interaction.Behaviors>
                                                            <behaviors:ComboBoxUnselector ClearTrigger="{Binding ClearComboBoxSelectionTrigger}" />
                                                        </i:Interaction.Behaviors>
                                                        <ComboBox.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <VirtualizingStackPanel />
                                                            </ItemsPanelTemplate>
                                                        </ComboBox.ItemsPanel>
                                                    </ComboBox>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.HeaderTemplate>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Mana Cost" IsReadOnly="True" Width="Auto" SortMemberPath="ManaValue">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding ManaCostImage}" Height="20" HorizontalAlignment="Right"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Card Supertypes" Width="*" SortMemberPath="SuperTypes">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SuperTypes}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Card Types" Width="*" SortMemberPath="Types">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Types}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Card Subtypes" Width="*" SortMemberPath="SubTypes">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SubTypes}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                        <Grid Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0">
                            <DataGrid x:Name="DeckDataGrid"
                                      AutoGenerateColumns="False"         
                                      ScrollViewer.CanContentScroll="True"
                                      EnableColumnVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      CanUserAddRows="False"
                                      CanUserSortColumns="True"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,126,0,-126">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Card Name" Width="*" SortMemberPath="Name">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Mana Cost" IsReadOnly="True" Width="Auto" SortMemberPath="ManaValue">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding ManaCostImage}" Height="20" HorizontalAlignment="Right"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Card Type" Width="*" SortMemberPath="Type">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Type}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Count" Width="*" SortMemberPath="Count">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Count}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Grid>
                <Grid x:Name="GridUtilitiesSection" d:IsHidden="True"
                      Visibility="{Binding DataContext.Main.CurrentPage,RelativeSource={RelativeSource AncestorType=Window},
                    Converter={StaticResource PageToVisibilityConverter},
                    ConverterParameter={x:Static presentation:Page.Utilities}}">
                    <Label Content="Utilities" Style="{StaticResource MediumHeaderLabelStyle}" />
                    <Image x:Name="Inspiredtinkering" Margin="0,200,0,0" Source="/Resources/Images/inspired-tinkering-183.png" HorizontalAlignment="Center" VerticalAlignment="Top" Width="600" Opacity="0.698"/>
                </Grid>
                <!-- Status window -->
                <local:StatusOverlay DataContext="{Binding DataContext.StatusOverlay, RelativeSource={RelativeSource AncestorType=Window}}" d:IsHidden="True"/>
                <local:ImportOverlay DataContext="{Binding DataContext.ImportOverlay, RelativeSource={RelativeSource AncestorType=Window}}" d:IsHidden="True"/>
            </Grid>
            <Grid x:Name="GridCardImages" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" Width="250" Margin="0,0,0,0" Visibility="{Binding CardViewSectionVisibility}">
                <Label x:Name="ImagePromoLabel" Content="{Binding CardImageVM.ImagePromoType}" HorizontalAlignment="Left" VerticalAlignment="Top" Height="30" Width="250" Style="{StaticResource BelerenBold}"/>
                <Label x:Name="ImageSetLabel" Content="{Binding CardImageVM.ImageSet}" HorizontalAlignment="Left" VerticalAlignment="Top" Height="30" Width="250" Margin="0,35,0,0" Style="{StaticResource BelerenBold}"/>
                <Image x:Name="CardImage"
                       Source="{Binding CardImageVM.FrontImageSource}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,80,10,0"/>
                <Image x:Name="CardImageSecondary"
                       Source="{Binding CardImageVM.BackImageSource}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top" Margin="0,461,10,0"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
