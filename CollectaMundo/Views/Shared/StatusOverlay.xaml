<UserControl x:Class="CollectaMundo.Views.Shared.StatusOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:CollectaMundo.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:StatusViewModel}"
             Visibility="{Binding StatusOverlayVisibility}"
             Style="{StaticResource {x:Type UserControl}}">
    <Grid>
        <Grid VerticalAlignment="Top" Margin="0,20,0,0">
            <Image Source="/Resources/Images/Logo.png"
                   Visibility="{Binding LogoVisibility}"
                   Stretch="Fill"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Center"
                   Height="300"
                   Width="300"
                   Margin="0,76,0,0"/>

            <Image Source="/Resources/Images/counterspell_fail.png"
                   Visibility="{Binding SetupFailVisibility}"
                   Stretch="None"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Center"
                   Height="300"
                   Width="300"
                   Margin="0,76,0,0"/>

            <Label Content="CollectaMundo" Style="{StaticResource BigHeaderLabelStyle}" />

            <ProgressBar Value="{Binding ProgressValue}" Visibility="{Binding ProgressVisibility}" Margin="0,410,0,0" 
                         Style="{StaticResource CollectaMundoProgressBarStyle}"/>

            <Label Content="{Binding StatusLabel1}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,380,0,0" FontSize="16"/>

            <Label Content="{Binding StatusLabel2}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,430,0,0" />

            <Label Content="{Binding StatusLabel3}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,460,0,0"/>

            <Button Command="{Binding PrimaryButtonCommand}"
                    Content="{Binding PrimaryButtonText}" 
                    Visibility="{Binding PrimaryButtonVisibility}"
                    HorizontalAlignment="Center" Margin="0,500,0,0" VerticalAlignment="Top"/>

            <Button Command="{Binding SecondaryButtonCommand}"
                    Content="{Binding SecondaryButtonText}" 
                    Visibility="{Binding SecondaryButtonVisibility}"
                    HorizontalAlignment="Center" Margin="0,550,0,0" VerticalAlignment="Top"/>
        </Grid>
    </Grid>
</UserControl>
