                                        <TextBlock Text="{Binding SelectedFinish}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Language" Width="*" SortMemberPath="Language">
