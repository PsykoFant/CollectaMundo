<UserControl x:Class="CollectaMundo.Views.ContentSection.Export.CollectionExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:utilities="clr-namespace:CollectaMundo.ViewModels.Utilities"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=utilities:CollectionExportViewModel}"
             d:Style="{StaticResource {x:Type UserControl}}"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid Margin="16" Background="Transparent"  MaxWidth="1000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Label Grid.Row="0"
           Content="Export Collection"
           Style="{StaticResource BigHeaderLabelStyle}" />

        <Label Grid.Row="1" Content="{Binding StatusMessage}" Style="{StaticResource SmallHeaderLabelStyle}" Margin="0,0,0,12" HorizontalAlignment="Center" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Margin="0,0,8,0" Padding="12" VerticalAlignment="Top">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <Label Content="Full collection backup" Style="{StaticResource SmallHeaderLabelStyle}" />
                    </DataTemplate>
                </GroupBox.HeaderTemplate>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="200" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Save a CSV backup of your complete collection, including saved sell prices and currencies." TextWrapping="Wrap" Margin="0,0,0,12" />
                        <TextBlock Text="Collection will be backed up to: " TextWrapping="Wrap" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding BackupFolderPath}" ToolTip="{Binding BackupFolderPath}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="  Open folder  " Command="{Binding OpenBackupFolderCommand}" HorizontalAlignment="Left" />
                            <Button Grid.Column="1" Content="  Change location  " Command="{Binding ChangeBackupFolderCommand}" HorizontalAlignment="Right" />
                        </Grid>                        
                    </StackPanel>
                    <Button Grid.Row="1" Content="  Create full backup " Height="20" Command="{Binding ExportFullCollectionBackupCommand}" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="1" Margin="8,0,0,0" Padding="12" VerticalAlignment="Top">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <Label Content="Trade list export" Style="{StaticResource SmallHeaderLabelStyle}" />
                    </DataTemplate>
                </GroupBox.HeaderTemplate>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="200" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Export cards marked for trade. Prices will be converted to the selected currency." TextWrapping="Wrap" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Label Content="Price currency" VerticalAlignment="Center" Padding="0,0,12,0" />
                            <ComboBox ItemsSource="{Binding CurrencyOptions}" SelectedItem="{Binding SelectedCurrency, Mode=TwoWay}" MinWidth="90" VerticalAlignment="Center" />
                        </StackPanel>                        
                    </StackPanel>
                    <Button Grid.Row="1" Content="  Export trade list  " Command="{Binding ExportTradeListCommand}" Height="20" />
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
