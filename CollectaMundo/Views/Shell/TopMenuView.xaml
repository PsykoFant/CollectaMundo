<UserControl x:Class="CollectaMundo.Views.Shell.TopMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:presentation="clr-namespace:CollectaMundo.Presentation" 
             xmlns:viewmodels="clr-namespace:CollectaMundo.ViewModels" 
             d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}"
             mc:Ignorable="d">

    <Grid x:Name="GridTopMenu"
          VerticalAlignment="Top"
          HorizontalAlignment="Center"
          Height="40"
          IsEnabled="{Binding IsTopMenuEnabled}">

        <Button Content="All Cards"
                Command="{Binding ShowAllCardsPageCommand}"
                HorizontalAlignment="Center"
                Margin="0,5,510,0"
                VerticalAlignment="Top"
                Width="160"
                Height="30">
            <Button.Effect>
                <DropShadowEffect ShadowDepth="5" BlurRadius="10" Opacity="0.6"/>
            </Button.Effect>
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource TopMenuButtonStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAllCardsPageActive}" Value="True">
                            <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <Button Content="My Collection"
                Command="{Binding ShowMyCollectionPageCommand}"
                HorizontalAlignment="Center"
                Margin="0,5,170,0"
                VerticalAlignment="Top"
                Width="160"
                Height="30">
            <Button.Effect>
                <DropShadowEffect ShadowDepth="5" BlurRadius="10" Opacity="0.6"/>
            </Button.Effect>
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource TopMenuButtonStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMyCollectionPageActive}" Value="True">
                            <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <Button Content="Decks"
                HorizontalAlignment="Center"
                Margin="170,5,0,0"
                VerticalAlignment="Top"
                Width="160"
                Height="30"
                Style="{StaticResource TopMenuButtonStyle}">
            <Button.Effect>
                <DropShadowEffect ShadowDepth="5" BlurRadius="10" Opacity="0.6"/>
            </Button.Effect>
        </Button>

        <Button 
                Content="Utilities"
                HorizontalAlignment="Center"
                Margin="510,5,0,0"
                VerticalAlignment="Top"
                Width="160"
                Height="30"
                Style="{StaticResource TopMenuButtonStyle}">
            <Button.Effect>
                <DropShadowEffect ShadowDepth="5" BlurRadius="10" Opacity="0.6"/>
            </Button.Effect>
        </Button>
        <!--Command="{Binding ShowUtilitiesCommand}"-->
        <!--Background="{Binding CurrentPage,Converter={StaticResource PageToBrushConverter},ConverterParameter={x:Static presentation:Page.Utilities}}"-->

    </Grid>
</UserControl>
