<UserControl x:Class="CollectaMundo.Views.ContentSection.Pages.PagesSearchAndFilterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:pagesVm="clr-namespace:CollectaMundo.ViewModels.Pages"
             xmlns:sharedElements="clr-namespace:CollectaMundo.Views.ContentSection.Pages.SharedElements"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:CollectaMundo.Presentation.Behaviors"
             xmlns:converters="clr-namespace:CollectaMundo.Presentation.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=pagesVm:PagesSearchAndFilterViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Label Content="{Binding PageTitle}" Style="{StaticResource MediumHeaderLabelStyle}"/>
        <!-- Add status summary, listview buttons -->
        <sharedElements:CardListPageChromeUserControl />

        <!--Cards to add listview-->
        <ListView ItemsSource="{Binding ModifyCollectionViewModel.CardsToAddOrEdit}"
                  Visibility="{Binding ModifyCollectionViewModel.IsCollectionEditVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                  behaviors:ListViewColumnRefreshBehavior.RefreshTrigger="{Binding ModifyCollectionViewModel.RefreshColumnsTrigger, Mode=OneWay}"
                  Margin="0,70,0,0" VerticalAlignment="Top" Height="170">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Card Name" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Set" DisplayMemberBinding="{Binding SetName}"/>
                    <GridViewColumn Header="Condition">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <sharedElements:RefreshColumnsComboBoxUserControl DataContext="{Binding ConditionCombo}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Finish">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <sharedElements:RefreshColumnsComboBoxUserControl DataContext="{Binding FinishCombo}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Language">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <sharedElements:RefreshColumnsComboBoxUserControl DataContext="{Binding LanguageCombo}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Location">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <sharedElements:RefreshColumnsLocationComboBoxUserControl DataContext="{Binding LocationCombo}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Comment">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="140" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>                    
                    <GridViewColumn Header="+">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="+" 
                                        Style="{StaticResource StepperButtonStyle}"
                                        Command="{Binding DataContext.ModifyCollectionViewModel.IncrementCountCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Count">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <sharedElements:NumericEditorUserControl DataContext="{Binding Owned}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="-">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="-"
                                        Style="{StaticResource StepperButtonStyle}"
                                        Command="{Binding DataContext.ModifyCollectionViewModel.DecrementCountCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="+">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="+" Style="{StaticResource StepperButtonStyle}"
                                        Command="{Binding DataContext.ModifyCollectionViewModel.IncrementTradeCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Trade">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <sharedElements:NumericEditorUserControl DataContext="{Binding Trade}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="-">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="-" Style="{StaticResource StepperButtonStyle}"
                                        Command="{Binding DataContext.ModifyCollectionViewModel.DecrementTradeCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <Button Content="Add selected cards to my collection"
                        HorizontalAlignment="Right" Margin="0,255,0,0" VerticalAlignment="Top"
                        Width="200" Height="20"
                        Visibility="{Binding ElementName=AllCardsDataGrid, Path=SelectedItems.Count, Converter={StaticResource CountToVisibilityConverter}}"
                        Command="{Binding ModifyCollectionViewModel.AddSelectedCardsCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=AllCardsDataGrid}" />
        
        <!--The main card view datagrid-->
        <DataGrid x:Name="AllCardsDataGrid"
                  ItemsSource="{Binding CardsVM.FilteredCards, NotifyOnTargetUpdated=True}"
                  Style="{StaticResource CardGridBaseStyle}" 
                  SelectedItem="{Binding CardImageVM.SelectedCard, Mode=TwoWay}"                  
                  behaviors:DataGridClearSelectionBehavior.ClearSelectionTrigger="{Binding ModifyCollectionViewModel.ClearSelectionTrigger, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="Name">                    
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <sharedElements:FilterHeaderUserControl DataContext="{Binding DataContext.NameFilter, ElementName=AllCardsDataGrid}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Set Name" Width="*" SortMemberPath="SetName">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <sharedElements:FilterHeaderUserControl DataContext="{Binding DataContext.SetNameFilter, ElementName=AllCardsDataGrid}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SetName}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>                
                <DataGridTemplateColumn Header="Icon" IsReadOnly="True" Width="Auto" SortMemberPath="ReleaseDate">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding KeyRuneImage}" Width="20" Height="20" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Mana Cost" IsReadOnly="True" Width="Auto" SortMemberPath="ManaValue">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding ManaCostImage}" Height="20" HorizontalAlignment="Right"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Card Types" Width="*" SortMemberPath="Type">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Type}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Finishes" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Finishes}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn SortMemberPath="NormalPrice" Width="*">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DataContext.PricesVM.PriceHeader, ElementName=AllCardsDataGrid}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding NormalPrice}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn SortMemberPath="FoilPrice" Width="*">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DataContext.PricesVM.FoilPriceHeader, ElementName=AllCardsDataGrid}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FoilPrice}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn SortMemberPath="EtchedPrice" Width="*">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DataContext.PricesVM.EtchedPriceHeader, ElementName=AllCardsDataGrid}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding EtchedPrice}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDoubleClick">
                    <i:InvokeCommandAction 
                                    Command="{Binding ModifyCollectionViewModel.AddSelectedCardsCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=AllCardsDataGrid}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Add selected card(s) to Collection"
                              Command="{Binding ModifyCollectionViewModel.AddSelectedCardsCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="Add selected card(s) with DEFAULT values to Collection"
                              Command="{Binding ModifyCollectionViewModel.SubmitNewCardsWithDefaultsCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              Style="{StaticResource BelerenBold}"/>
                    <MenuItem Header="">
                        <MenuItem.Template>
                            <ControlTemplate>
                                <Label Content="Default values are:" Margin="30,0,0,0"/>
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                    <MenuItem Header="">
                        <MenuItem.Template>
                            <ControlTemplate>
                                <Label Content=" - Condition: Near Mint" Margin="30,0,0,0"/>
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                    <MenuItem Header="">
                        <MenuItem.Template>
                            <ControlTemplate>
                                <Label Content=" - Language: English" Margin="30,0,0,0"/>
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                    <MenuItem Header="">
                        <MenuItem.Template>
                            <ControlTemplate>
                                <Label Content=" - Finish: nonfoil" Margin="30,0,0,0"/>
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                    <MenuItem Header="">
                        <MenuItem.Template>
                            <ControlTemplate>
                                <Label Content=" - Count: 1" Margin="30,0,0,0"/>
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                    <MenuItem Header="">
                        <MenuItem.Template>
                            <ControlTemplate>
                                <Label Content=" - Trade: 0" Margin="30,0,0,0"/>
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>
</UserControl>
