<UserControl x:Class="CollectaMundo.Views.ContentSection.Decks.DeckCardGridUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sharedElements="clr-namespace:CollectaMundo.Views.ContentSection.Pages.SharedElements"
             x:Name="Root">

    <DataGrid ItemsSource="{Binding ItemsSource, ElementName=Root}" SelectedItem="{Binding SelectedItem, ElementName=Root, Mode=TwoWay}"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              IsReadOnly="True"
              Style="{StaticResource DeckCardGridStyle}">

        <DataGrid.Columns>
            <DataGridTemplateColumn Header="Card Name"
                                    Width="*"
                                    SortMemberPath="CardName">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       Foreground="DarkRed"
                                       FontSize="16"
                                       Text="⚠"
                                       ToolTip="This card is not legal in the selected format">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLegal}"
                                                         Value="False">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding CardName}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Mana Cost"
                                    Width="Auto">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <Image Source="{Binding ManaCostImage}"
                               Height="20"
                               HorizontalAlignment="Right"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Card types"
                                    Width="Auto"
                                    Visibility="{Binding ShowCardTypeColumn,
                                                         ElementName=Root,
                                                         Converter={StaticResource BoolToVisibilityConverter}}">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Type}"
                                   TextWrapping="Wrap"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="Owned"
                                Width="70"
                                Binding="{Binding OwnedQuantity}"
                                IsReadOnly="True"
                                Visibility="{Binding ShowOwnedColumn,
                                                     ElementName=Root,
                                                     Converter={StaticResource BoolToVisibilityConverter}}"/>

            <DataGridTextColumn Header="Allocated"
                                Width="80"
                                Binding="{Binding AllocatedQuantity}"
                                IsReadOnly="True"
                                Visibility="{Binding ShowAllocatedColumn,
                                                     ElementName=Root,
                                                     Converter={StaticResource BoolToVisibilityConverter}}"/>

            <DataGridTemplateColumn Header="+"
                                    Visibility="{Binding ShowQuantityControls,
                                                         ElementName=Root,
                                                         Converter={StaticResource BoolToVisibilityConverter}}">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <Button Content="+"
                                Style="{StaticResource StepperButtonStyle}"
                                Command="{Binding DataContext.IncrementDeckCardQuantityCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Quantity"
                                    Visibility="{Binding ShowQuantityControls,
                                                         ElementName=Root,
                                                         Converter={StaticResource BoolToVisibilityConverter}}">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <sharedElements:NumericEditorUserControl
                            DataContext="{Binding DesiredQuantityBinding}"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="-"
                                    Visibility="{Binding ShowQuantityControls,
                                                         ElementName=Root,
                                                         Converter={StaticResource BoolToVisibilityConverter}}">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <Button Content="-"
                                Style="{StaticResource StepperButtonStyle}"
                                Command="{Binding DataContext.DecrementDeckCardQuantityCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </DataGrid.Columns>

        <DataGrid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="{Binding DeleteMenuHeader,
                                           Source={x:Reference Root}}"
                          Command="{Binding PlacementTarget.DataContext.DataContext.DeleteDeckCardsCommand,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.SelectedItems,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            </ContextMenu>
        </DataGrid.ContextMenu>

        <DataGrid.InputBindings>
            <KeyBinding Key="Delete"
                        Command="{Binding DataContext.DeleteDeckCardsCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding SelectedItems,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
        </DataGrid.InputBindings>
    </DataGrid>
</UserControl>
