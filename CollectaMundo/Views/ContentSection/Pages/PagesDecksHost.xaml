<UserControl x:Class="CollectaMundo.Views.ContentSection.Pages.PagesDecksHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:deckViews="clr-namespace:CollectaMundo.Views.ContentSection.Decks"
             xmlns:deckVms="clr-namespace:CollectaMundo.ViewModels.Decks"
             xmlns:pagesVm="clr-namespace:CollectaMundo.ViewModels.Pages"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=pagesVm:PagesDecksHostViewModel}"
             
             d:DesignHeight="500" d:DesignWidth="800">

    <Grid>
        <ContentControl Content="{Binding CurrentDecksContentViewModel}">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type deckVms:DeckManagementViewModel}"><deckViews:DeckManagementView/></DataTemplate>
                <DataTemplate DataType="{x:Type deckVms:DeckEditorViewModel}"><deckViews:DeckEditorView /></DataTemplate>
            </ContentControl.Resources>
        </ContentControl>
    </Grid>
</UserControl>
