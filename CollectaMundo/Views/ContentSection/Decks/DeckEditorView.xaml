<UserControl x:Class="CollectaMundo.Views.ContentSection.Decks.DeckEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:deckViewModels="clr-namespace:CollectaMundo.ViewModels.Decks"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=deckViewModels:DeckEditorViewModel}"
             d:Style="{StaticResource {x:Type UserControl}}"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Label Content="Deck Editor"
                   Style="{StaticResource MediumHeaderLabelStyle}"
                   DockPanel.Dock="Left"/>

            <Button Content="Back to Decks"
                    Width="120"
                    Height="24"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Command="{Binding BackToDeckManagementCommand}"/>
        </DockPanel>

        <!-- Top: Deck list + Stats -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Deck rows -->
            <GroupBox Grid.Column="0" Header="Deck">
                <DataGrid x:Name="DeckCardsDataGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="False"
                          Style="{StaticResource CardGridBaseStyle}">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Qty"
                                            Width="50"/>

                        <DataGridTemplateColumn Header="Card Name"
                                                Width="*"
                                                SortMemberPath="CardName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Mana Cost"
                                                Width="Auto"
                                                SortMemberPath="ManaValue">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Height="20"
                                           HorizontalAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Owned"
                                            Width="70"
                                            IsReadOnly="True"/>

                        <DataGridTextColumn Header="Allocated"
                                            Width="80"
                                            IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- Stats placeholder -->
            <GroupBox Grid.Column="2" Header="Stats">
                <StackPanel Margin="8">
                    <TextBlock Text="Deck stats will go here later."
                               TextWrapping="Wrap"
                               Opacity="0.7"/>

                    <Separator Margin="0,8"/>

                    <TextBlock/>
                    <TextBlock/>
                    <TextBlock/>
                    <TextBlock/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- Bottom: Filterable oracle card source -->
        <GroupBox Grid.Row="3" Header="Add Cards">
            <DataGrid x:Name="AvailableCardsDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      Style="{StaticResource CardGridBaseStyle}">

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Card Name"
                                            Width="*"
                                            SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Mana Cost"
                                            Width="Auto"
                                            SortMemberPath="ManaValue">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Height="20"
                                       HorizontalAlignment="Right"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</UserControl>
