<UserControl x:Class="CollectaMundo.Views.Pages.SharedElements.RefreshColumnsComboBoxUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors" xmlns:sharedelements="clr-namespace:CollectaMundo.ViewModels.Pages.SharedElements"              
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=sharedelements:ComboBindingViewModel}"
             d:DesignHeight="24"
             d:DesignWidth="120">

    <ComboBox ItemsSource="{Binding Items}"
              SelectedItem="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              MinWidth="60">

        <i:Interaction.Triggers>
            <i:EventTrigger EventName="SelectionChanged">
                <i:InvokeCommandAction Command="{Binding RefreshCommand}" />
            </i:EventTrigger>
        </i:Interaction.Triggers>

    </ComboBox>
</UserControl>
