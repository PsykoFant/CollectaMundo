<UserControl x:Class="CollectaMundo.Views.Pages.SearchAndFilterPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:pagesVm="clr-namespace:CollectaMundo.ViewModels.Pages"
             xmlns:shared="clr-namespace:CollectaMundo.Views.Pages.SharedElements"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:CollectaMundo.Presentation.Behaviors"
             xmlns:validation="clr-namespace:CollectaMundo.Presentation.Validation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=pagesVm:CardListPageViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Label Content="Search and Filter Cards" Style="{StaticResource MediumHeaderLabelStyle}"/>
        <Label Visibility="{Binding AddCardsVM.StatusVisibility,Converter={StaticResource InverseVisibility}}"
                       HorizontalAlignment="Left" Margin="0,25,0,0" VerticalAlignment="Top" Height="30" >
            <Label.Content>
                <MultiBinding Converter="{StaticResource CountToSummaryConverter}">
                    <Binding Path="CardsVM.FilteredCount"/>
                    <Binding Path="CardsVM.TotalCount"/>
                </MultiBinding>
            </Label.Content>
        </Label>
        <Button Content="Submit these cards to my collection" HorizontalAlignment="Right" Margin="0,45,0,0" VerticalAlignment="Top" Width="200" Height="20" 
                            Visibility="{Binding AddCardsVM.CollectionEditVisibility}"
                            Command="{Binding AddCardsVM.SubmitNewCardsCommand}" />
        <Button Content="Clear cards without submitting"
                        HorizontalAlignment="Right" Margin="0,45,210,0" VerticalAlignment="Top"
                        Width="200" Height="20"
                        Visibility="{Binding AddCardsVM.CollectionEditVisibility}"
                        Command="{Binding AddCardsVM.ClearCardsToAddCommand}" />
        <Button Content="Add selected cards to my collection"
                        HorizontalAlignment="Right" Margin="0,255,0,0" VerticalAlignment="Top"
                        Width="200" Height="20"
                        Visibility="{Binding ElementName=AllCardsDataGrid, Path=SelectedItems.Count, Converter={StaticResource CountToVisibilityConverter}}"
                        Command="{Binding AddCardsVM.AddSelectedCardsCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=AllCardsDataGrid}" />
        <ScrollViewer HorizontalAlignment="Left" Margin="0,40,0,0" VerticalAlignment="Top" Height="187" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <TextBlock TextWrapping="Wrap" VerticalAlignment="Top" Text="{Binding AddCardsVM.StatusMessage}"/>
        </ScrollViewer>
        <!--Cards to add listview-->
        <ListView DataContext="{Binding AddCardsVM}"
                                  ItemsSource="{Binding CardsToAdd}"
                                  Visibility="{Binding CollectionEditVisibility}"                          
                                  behaviors:ListViewColumnRefreshBehavior.RefreshTrigger="{Binding RefreshColumnsTrigger, Mode=OneWay}"                          
                                  Margin="0,70,0,0" VerticalAlignment="Top" Height="170">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Card Name" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Set" DisplayMemberBinding="{Binding SetName}"/>
                    <GridViewColumn Header="Condition">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Conditions}"
                                                          SelectedItem="{Binding SelectedCondition, UpdateSourceTrigger=PropertyChanged}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding DataContext.RefreshColumnsCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </ComboBox>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Finish">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding AvailableFinishes}" 
                                                          SelectedItem="{Binding SelectedFinish, UpdateSourceTrigger=PropertyChanged}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding DataContext.RefreshColumnsCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </ComboBox>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Language">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding OtherLanguages}" 
                                                          SelectedItem="{Binding Language, UpdateSourceTrigger=PropertyChanged}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding DataContext.RefreshColumnsCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </ComboBox>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="+">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="+" Width="15" Background="#FFFBF7B4"
                                                    Command="{Binding DataContext.IncrementCountCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListViewItem}}, Path=DataContext}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Count">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox HorizontalAlignment="Center" Background="White">
                                    <TextBox.Text>
                                        <Binding Path="CardsOwned" Mode="TwoWay" UpdateSourceTrigger="Explicit" ValidatesOnDataErrors="True" NotifyOnValidationError="True">
                                            <Binding.ValidationRules>
                                                <validation:IntegerValidationRule />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                    <i:Interaction.Behaviors>
                                        <behaviors:DelayedUpdateBehavior Delay="500"/>
                                        <behaviors:NumericValidationBehavior />
                                    </i:Interaction.Behaviors>
                                </TextBox>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="-">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="-" Width="15" Background="#FFFBF7B4"
                                                    Command="{Binding DataContext.DecrementCountCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListViewItem}}, Path=DataContext}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="+">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="+" Width="15" Background="#FFFBF7B4"
                                                    Command="{Binding DataContext.IncrementTradeCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListViewItem}}, Path=DataContext}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Trade">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox HorizontalAlignment="Center" Background="White">
                                    <TextBox.Text>
                                        <Binding Path="CardsForTrade" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"
                                                                 ValidatesOnDataErrors="True" NotifyOnValidationError="True">
                                            <Binding.ValidationRules>
                                                <validation:IntegerValidationRule />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                    <i:Interaction.Behaviors>
                                        <behaviors:NumericValidationBehavior />
                                    </i:Interaction.Behaviors>
                                </TextBox>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="-">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="-" Width="15" Background="#FFFBF7B4"
                                                    Command="{Binding DataContext.DecrementTradeCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListViewItem}}, Path=DataContext}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        <!--The main card view datagrid-->
        <DataGrid x:Name="AllCardsDataGrid"
                  ItemsSource="{Binding CardsVM.FilteredCards, NotifyOnTargetUpdated=True}"
                  Style="{StaticResource CardGridBaseStyle}" 
                  SelectedItem="{Binding CardImageVM.SelectedCard, Mode=TwoWay}"                  
                  behaviors:DataGridClearSelectionBehavior.ClearSelectionTrigger="{Binding AddCardsVM.ClearSelectionTrigger, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="Name">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <shared:FilterHeaderView DataContext="{Binding DataContext.NameHeader, ElementName=AllCardsDataGrid}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Set Name" Width="*" SortMemberPath="SetName">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <shared:FilterHeaderView DataContext="{Binding DataContext.SetNameHeader, ElementName=AllCardsDataGrid}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SetName}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>                
                <DataGridTemplateColumn Header="Icon" IsReadOnly="True" Width="Auto" SortMemberPath="ReleaseDate">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding KeyRuneImage}" Width="20" Height="20" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Mana Cost" IsReadOnly="True" Width="Auto" SortMemberPath="ManaValue">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding ManaCostImage}" Height="20" HorizontalAlignment="Right"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Card Types" Width="*" SortMemberPath="Type">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Type}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Finishes" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Finishes}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn SortMemberPath="NormalPrice" Width="*">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DataContext.PricesVM.PriceHeader, ElementName=AllCardsDataGrid}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding NormalPrice}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn SortMemberPath="FoilPrice" Width="*">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DataContext.PricesVM.FoilPriceHeader, ElementName=AllCardsDataGrid}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FoilPrice}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn SortMemberPath="EtchedPrice" Width="*">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DataContext.PricesVM.EtchedPriceHeader, ElementName=AllCardsDataGrid}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding EtchedPrice}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDoubleClick">
                    <i:InvokeCommandAction 
                                    Command="{Binding AddCardsVM.AddSelectedCardsCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=AllCardsDataGrid}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Add selected card(s) to Collection"
                              Command="{Binding AddCardsVM.AddSelectedCardsCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="Add selected card(s) with DEFAULT values to Collection"
                              Command="{Binding AddCardsVM.SubmitNewCardsWithDefaultsCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              Style="{StaticResource BelerenBold}"/>
                    <MenuItem Header="">
                        <MenuItem.Template>
                            <ControlTemplate>
                                <Label Content="Default values are:" Margin="30,0,0,0"/>
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                    <MenuItem Header="">
                        <MenuItem.Template>
                            <ControlTemplate>
                                <Label Content=" - Condition: Near Mint" Margin="30,0,0,0"/>
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                    <MenuItem Header="">
                        <MenuItem.Template>
                            <ControlTemplate>
                                <Label Content=" - Language: English" Margin="30,0,0,0"/>
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                    <MenuItem Header="">
                        <MenuItem.Template>
                            <ControlTemplate>
                                <Label Content=" - Finish: nonfoil" Margin="30,0,0,0"/>
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                    <MenuItem Header="">
                        <MenuItem.Template>
                            <ControlTemplate>
                                <Label Content=" - Count: 1" Margin="30,0,0,0"/>
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                    <MenuItem Header="">
                        <MenuItem.Template>
                            <ControlTemplate>
                                <Label Content=" - Trade: 0" Margin="30,0,0,0"/>
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>
</UserControl>
