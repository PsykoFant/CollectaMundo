<UserControl x:Class="CollectaMundo.Views.Import.ImportStep01_StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vmsteps="clr-namespace:CollectaMundo.ViewModels.ImportSteps"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vmsteps:ImportStep01_StartViewModel}"
             d:Style="{StaticResource {x:Type UserControl}}"
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid HorizontalAlignment="Center">
        <FlowDocumentScrollViewer Visibility="{Binding FlowDocumentVisibility}"
        Margin="0,60,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Width="600">
            <FlowDocument>
                <Paragraph>
                    You have chosen to consult the Import Wizard. This will allow you to import card lists to your collection.
                </Paragraph>

                <Paragraph>
                    Some important notes:
                </Paragraph>

                <List MarkerStyle="Disc">
                    <ListItem>
                        <Paragraph>Card list has to be in a .csv format</Paragraph>
                    </ListItem>
                    <ListItem>
                        <Paragraph>Imported cards will be ADDED to existing cards in your collection</Paragraph>
                    </ListItem>
                    <ListItem>
                        <Paragraph>Imported cards will be mapped to a specific version of the card</Paragraph>
                    </ListItem>
                </List>

                <Paragraph>Example:</Paragraph>

                <List MarkerStyle="Disc">
                    <ListItem>
                        <Paragraph>Your csv-file has: | Flooded Strand | Modern Horizons 3 |</Paragraph>
                    </ListItem>
                    <ListItem>
                        <Paragraph>... but corporate greed dictates that at least four versions of a card must exist!</Paragraph>
                    </ListItem>
                    <ListItem>
                        <Paragraph>... so we need to figure out which version to add to your collection!</Paragraph>
                    </ListItem>
                </List>

                <Paragraph>But fear not, The Import Wizard will guide you!</Paragraph>
            </FlowDocument>
        </FlowDocumentScrollViewer>

        <Image Margin="0,370,0,0"
               Source="/Resources/Images/rush_of_knowledge.jpg"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               Height="195"
               Width="245"
               Opacity="0.7"/>
    </Grid>
</UserControl>
