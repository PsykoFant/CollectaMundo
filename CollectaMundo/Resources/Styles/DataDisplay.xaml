<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:CollectaMundo.Presentation.Behaviors">

    <!-- ============================================================
     DATAGRID STYLES
     ============================================================ -->

    <!-- DataGrid: Base -->
    <Style x:Key="DataGridBaseStyle" TargetType="{x:Type DataGrid}">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="EnableColumnVirtualization" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>

        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserSortColumns" Value="True"/>
        <Setter Property="CanUserResizeColumns" Value="True"/>

        <Setter Property="SelectionMode" Value="Extended"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>

        <Setter Property="HorizontalAlignment" Value="Stretch"/>

        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <!-- (optional) also: -->
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DataGrid: Card Grid Base -->
    <Style x:Key="CardGridBaseStyle" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource DataGridBaseStyle}">
        <!-- your attached behaviors (static values only) -->
        <Setter Property="behaviors:DataGridPersistSortBehavior.Enable" Value="True"/>
    </Style>

    <!-- DataGrid: Management -->
    <Style x:Key="ManagementGridStyle" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource DataGridBaseStyle}">
        <Setter Property="MinHeight" Value="40"/>
    </Style>

    <!-- DataGrid: Deck Builder Row -->
    <Style x:Key="DeckCardRowStyle"
       TargetType="{x:Type DataGridRow}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLegal}" Value="False">
                <Setter Property="Background" Value="#20D32F2F"/>
                <Setter Property="Foreground" Value="#FFB71C1C"/>
                <Setter Property="ToolTip" Value="This card is not legal in the selected format."/>
            </DataTrigger>

            <Trigger Property="IsSelected"
                 Value="True">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- DataGrid: Deck Cards -->
    <Style x:Key="DeckCardGridStyle" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource CardGridBaseStyle}">
        <Setter Property="RowStyle" Value="{StaticResource DeckCardRowStyle}"/>
        <Setter Property="ColumnWidth" Value="Auto"/>
    </Style>

    <!-- DataGrid: Deckbox -->
    <Style x:Key="DeckBoxDataGridStyle" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource CardGridBaseStyle}">
        <Setter Property="ColumnWidth" Value="Auto"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="RowBackground" Value="#F7F7F7"/>
        <Setter Property="AlternatingRowBackground" Value="#EEEEEE"/>
        <Setter Property="AlternationCount" Value="2"/>
    </Style>

    <!-- ============================================================
     DECK BUILDER STYLES
     ============================================================ -->

    <!-- Deck Builder: GroupBox -->
    <Style x:Key="DeckBuilderGroupBoxStyle"
       TargetType="{x:Type GroupBox}">

        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Full-width header -->
                        <ContentPresenter Grid.Row="0"
                                      ContentSource="Header"
                                      HorizontalAlignment="Stretch"/>

                        <!-- GroupBox content -->
                        <ContentPresenter Grid.Row="1"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
     PROGRESS BAR STYLES
     ============================================================ -->    
    
    <!-- ProgressBar -->
    <Style x:Key="CollectaMundoProgressBarStyle" TargetType="{x:Type ProgressBar}">

        <Setter Property="Height" Value="15" />
        <Setter Property="Width" Value="500" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="BorderBrush" Value="Black" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="#E5E5E5" />
        <Setter Property="Maximum" Value="100" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Border x:Name="PART_Track"
                        CornerRadius="2"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Background="{TemplateBinding Background}"
                        ClipToBounds="True">
                        <Grid>
                            <!-- Determinate indicator -->
                            <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                CornerRadius="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#fcffd3" Offset="0" />
                                        <GradientStop Color="#213c4c" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Indeterminate moving segment -->
                            <Border x:Name="IndeterminateIndicator"
                                Width="120"
                                HorizontalAlignment="Left"
                                CornerRadius="2"
                                Visibility="Collapsed">

                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="IndeterminateTranslate" X="-120" />
                                </Border.RenderTransform>

                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#fcffd3" Offset="0" />
                                        <GradientStop Color="#213c4c" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsIndeterminate" Value="True">

                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IndeterminateIndicator" Property="Visibility" Value="Visible" />

                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="IndeterminateAnimation">
                                    <Storyboard RepeatBehavior="Forever">

                                        <DoubleAnimation
                                            Storyboard.TargetName="IndeterminateTranslate"
                                            Storyboard.TargetProperty="X"
                                            From="-120"
                                            To="500"
                                            Duration="0:0:1.3" />

                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>

                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="IndeterminateAnimation" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <!-- ============================================================
     DOCUMENT / TEXT DISPLAY STYLES
     ============================================================ -->

    <!-- FlowDocumentScrollViewer: Default -->
    <Style TargetType="{x:Type FlowDocumentScrollViewer}">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
        <Setter Property="IsToolBarVisible" Value='False'/>
    </Style>

</ResourceDictionary>
