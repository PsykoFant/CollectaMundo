<UserControl x:Class="CollectaMundo.Views.SideMenuLeft.SideMenuFilteringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:sideMenuVm="clr-namespace:CollectaMundo.ViewModels.SideMenuLeft"
             xmlns:sideMenuLeft="clr-namespace:CollectaMundo.Views.SideMenuLeft"
             mc:Ignorable="d" 
             d:Style="{StaticResource {x:Type UserControl}}"
             d:DataContext="{d:DesignInstance Type=sideMenuVm:SideMenuFilteringViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="700" d:DesignWidth="250">
    <Grid Margin="10,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>        <!-- 0 - clear filters button -->
            <RowDefinition Height="Auto"/>      <!-- 1 - oracle card propeties -->
            <RowDefinition Height="Auto"/>      <!-- 2 - printing card propeties -->
            <RowDefinition Height="Auto"/>      <!-- 3 - collection card propeties -->
        </Grid.RowDefinitions>

        <!-- 0 - clear filters button -->
        <Button Grid.Row="0" Content="Clear filters" VerticalAlignment="Top" Height="20" Command="{Binding FilterVM.ClearFiltersCommand}"/>

        <!-- 1 - oracle card propeties -->
        <StackPanel Grid.Row="1" Margin="0,10,0,0">

            <!--Color filtering-->
            <Grid>                
                <ListBox ItemsSource="{Binding FilterVM.Filters[Colors].FilterOptions}"
                                 SelectionMode="Extended" HorizontalAlignment="Left"
                                 Height="170" VerticalAlignment="Top" Background="{x:Null}" 
                                 BorderBrush="{x:Null}" Foreground="{x:Null}">
                    <ListBox.Resources>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="SnapsToDevicePixels" Value="true" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <CheckBox Margin="5,2"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              Content="{Binding OptionName}"
                                                              FontSize="{Binding ., Converter={StaticResource ColorlessFontConverter}, ConverterParameter=30}"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>
                </ListBox>

                <ListBox ItemsSource="{Binding ColorIconsViewModel.Cards}"
                                     Margin="20,0,0,0" HorizontalAlignment="Left"
                                     Height="160" VerticalAlignment="Top" Background="{x:Null}" 
                                     BorderBrush="{x:Null}" Foreground="{x:Null}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding ManaCostImage}" Height="15" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ComboBox DataContext="{Binding FilterVM.Filters[Colors]}"
                                      Width="60"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Right"
                                      ItemsSource="{Binding AvailableOperators}"
                                      SelectedItem="{Binding OperatorSelection, Mode=TwoWay}">
                </ComboBox>
            </Grid>
            
            <!--Mana value filtering-->
            <Label x:Name="ManaValueLabel" Content="Mana value is: " HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource BelerenBold}"/>

            <Grid Margin="0,0,0,10">
                <!-- Operator Selection -->
                <ComboBox ItemsSource="{Binding FilterVM.Filters[ManaValue].AvailableOperators}"
                          SelectedItem="{Binding FilterVM.Filters[ManaValue].OperatorSelection, Mode=TwoWay}"
                          HorizontalAlignment="Left"
                          Width="150">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource OperatorToSymbolConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                
                <!-- Numeric Value Selection -->
                <ComboBox ItemsSource="{Binding FilterVM.Filters[ManaValue].AvailableNumericOptions}"
                          SelectedItem="{Binding FilterVM.Filters[ManaValue].SelectedNumericValue, Mode=TwoWay}"
                          HorizontalAlignment="Right"
                          Width="80"/>
            </Grid>

            <sideMenuLeft:FilterComboBoxPairRowUserControl DataContext="{Binding FilterVM.Filters[Rarity]}" />
            <sideMenuLeft:FilterComboBoxPairRowUserControl DataContext="{Binding FilterVM.Filters[SuperTypes]}" />
            <sideMenuLeft:FilterComboBoxPairRowUserControl DataContext="{Binding FilterVM.Filters[Types]}" />
            <sideMenuLeft:FilterComboBoxPairRowUserControl DataContext="{Binding FilterVM.Filters[SubTypes]}" />
            <sideMenuLeft:FilterComboBoxPairRowUserControl DataContext="{Binding FilterVM.Filters[Keywords]}" />
            
            <!--Rulestext filtering-->
            <TextBox DataContext="{Binding FilterVM.Filters[Text]}"
                 Text="{Binding FreetextSearch, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                 TextWrapping="Wrap" 
                 Foreground="{Binding TextForeground, Mode=TwoWay}" 
                 Height="45">
                <i:Interaction.Triggers>
                    <!-- Enter + Escape key binding -->
                    <i:EventTrigger EventName="PreviewKeyDown">
                        <i:InvokeCommandAction Command="{Binding KeyPressedCommand}"
                           PassEventArgsToCommand="True"/>
                    </i:EventTrigger>

                    <!-- Focus behavior (unchanged) -->
                    <i:EventTrigger EventName="GotFocus">
                        <i:InvokeCommandAction Command="{Binding TextBoxGotFocusCommand}" />
                    </i:EventTrigger>
                    <i:EventTrigger EventName="LostFocus">
                        <i:InvokeCommandAction Command="{Binding TextBoxLostFocusCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </TextBox>
        </StackPanel>

        <!-- 2 - printing card propeties -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0" Visibility="{Binding IsPrintingCardFilteringVisble, Converter={StaticResource BoolToVisibilityConverter}}">
            <sideMenuLeft:FilterComboBoxPairRowUserControl DataContext="{Binding FilterVM.Filters[Finishes]}" />
            <sideMenuLeft:FilterComboBoxPairRowUserControl DataContext="{Binding FilterVM.Filters[Availability]}" />
        </StackPanel>        

        <!-- 3 - collection card propeties -->
        <StackPanel Grid.Row="3" Visibility="{Binding IsCollectionCardFilteringVisble, Converter={StaticResource BoolToVisibilityConverter}}">
            <sideMenuLeft:FilterComboBoxPairRowUserControl DataContext="{Binding FilterVM.Filters[SelectedCondition]}" />
            <sideMenuLeft:FilterComboBoxPairRowUserControl DataContext="{Binding FilterVM.Filters[SelectedFinish]}" />
            <sideMenuLeft:FilterComboBoxPairRowUserControl DataContext="{Binding FilterVM.Filters[Language]}" />
            <sideMenuLeft:FilterComboBoxPairRowUserControl DataContext="{Binding FilterVM.Filters[SelectedLocationDisplayName]}" />
            <CheckBox  Content="Filter on cards for trade" IsChecked="{Binding FilterVM.Filters[CardsForTrade].IsTradeChecked, Mode=TwoWay}"/>
            <CheckBox Content="Filter on cards NOT for trade" IsChecked="{Binding FilterVM.Filters[CardsForTrade].IsNotTradeChecked, Mode=TwoWay}"/>
            <TextBox Margin="0,10,0,0"
                     DataContext="{Binding FilterVM.Filters[Comment]}"
                     Text="{Binding FreetextSearch, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                     TextWrapping="Wrap" 
                     Foreground="{Binding TextForeground, Mode=TwoWay}" 
                     Height="20">
                <i:Interaction.Triggers>
                    <!-- Enter + Escape key binding -->
                    <i:EventTrigger EventName="PreviewKeyDown">
                        <i:InvokeCommandAction Command="{Binding KeyPressedCommand}"
                           PassEventArgsToCommand="True"/>
                    </i:EventTrigger>

                    <!-- Focus behavior (unchanged) -->
                    <i:EventTrigger EventName="GotFocus">
                        <i:InvokeCommandAction Command="{Binding TextBoxGotFocusCommand}" />
                    </i:EventTrigger>
                    <i:EventTrigger EventName="LostFocus">
                        <i:InvokeCommandAction Command="{Binding TextBoxLostFocusCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </TextBox>
        </StackPanel>
    </Grid>
</UserControl>
