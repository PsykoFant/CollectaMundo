<UserControl x:Class="CollectaMundo.Views.SideMenuLeft.SideMenuUtilitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:sideMenuVm="clr-namespace:CollectaMundo.ViewModels.SideMenuLeft"
             mc:Ignorable="d" 
             d:Style="{StaticResource {x:Type UserControl}}"
             d:DataContext="{d:DesignInstance Type=sideMenuVm:SideMenuUtilitiesViewModel, IsDesignTimeCreatable=False}"              
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid x:Name="GridUtilsMenu">
        <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="10,0,0,0">

            <Button Command="{Binding UtilitiesVM.BackupCollectionCommand}"
                    Content="Create backup of my collection"
                    Width="180"
                    Height="20"/>

            <Button Command="{Binding UtilitiesVM.ImportFromCsvCommand}"
                    Content="The Import Wizard"
                    Width="180"
                    Height="20"
                    Margin="0,10,0,0"/>

            <Label Content="{Binding PricesVM.LatestPriceUpdateDate}"
                   Margin="0,20,0,0"/>

            <Button Command="{Binding UtilitiesVM.UpdatePricesCommand}"
                    Content="Update card prices"
                    Width="180"
                    Height="20"
                    Margin="0,10,0,0"/>

            <Label Content="Show prices from:"
                   Margin="0,5,0,0"/>

            <ComboBox ItemsSource="{Binding PricesVM.Retailers}"
                      SelectedItem="{Binding PricesVM.SelectedRetailer, Mode=TwoWay}"
                      DisplayMemberPath="Display"
                      SelectedValuePath="Key"
                      Margin="0,5,0,0">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction
                            Command="{Binding PricesVM.ChangeRetailerCommand}"
                            CommandParameter="{Binding SelectedValue, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ComboBox>

            <Button Command="{Binding UtilitiesVM.CheckForDbUpdatesCommand}"
                    Content="Check for card database updates"
                    Width="180"
                    Height="20"
                    Margin="0,20,0,0"/>

            <Button Command="{Binding UtilitiesVM.UpdateDBCommand}"
                    Visibility="{Binding UtilitiesVM.IsUpdateDbButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    Content="Update card database"
                    Width="180"
                    Height="20"
                    Margin="0,10,0,0"/>

            <Button Command="{Binding UtilitiesVM.ManageCardLocationsCommand}"
                    Content="Manage card locations"
                    Width="180"
                    Height="20"
                    Margin="0,10,0,0"/>

        </StackPanel>
    </Grid>
</UserControl>
