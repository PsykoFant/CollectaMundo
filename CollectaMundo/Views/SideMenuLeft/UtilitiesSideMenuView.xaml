<UserControl x:Class="CollectaMundo.Views.SideMenuLeft.UtilitiesSideMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:sideMenuVm="clr-namespace:CollectaMundo.ViewModels.SideMenuLeft"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=sideMenuVm:UtilitiesSideMenuViewModel, IsDesignTimeCreatable=False}"              
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid x:Name="GridUtilsMenu">
        <Button Command="{Binding UtilitiesVM.BackupCollectionCommand}" Content="Create backup of my collection" HorizontalAlignment="Left" Margin="10,0,0,0" Height="20" Width="180" VerticalAlignment="Top"/>
        <Button Command="{Binding UtilitiesVM.ImportFromCsvCommand}" Content="The Import Wizard" HorizontalAlignment="Left" Margin="10,30,0,0" Width="180" Height="20" VerticalAlignment="Top"/>

        <Label Content="{Binding PricesVM.LatestPriceUpdateDate}" Margin="10,70,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        <Button Command="{Binding UtilitiesVM.UpdatePricesCommand}" Content="Update card prices" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,100,0,0" Width="180" Height="20"/>
        <Label Content="Show prices from:" Margin="10,125,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        <ComboBox ItemsSource="{Binding PricesVM.Retailers}"
                              SelectedItem="{Binding PricesVM.SelectedRetailer, Mode=TwoWay}"
                              DisplayMemberPath="Display" SelectedValuePath="Key" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,155,0,0">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
                    <i:InvokeCommandAction
                                    Command="{Binding PricesVM.ChangeRetailerCommand}"
                                    CommandParameter="{Binding SelectedValue, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </ComboBox>
        <Button Command="{Binding UtilitiesVM.CheckForDbUpdatesCommand}"
                            Content="Check for card database updates"                            
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,220,0,0" Width="180" Height="20"/>
        <Button Command="{Binding UtilitiesVM.UpdateDBCommand}"
                            Content="Update card database"
                            Visibility="{Binding UtilitiesVM.UpdateDbVisibility}"
                            HorizontalAlignment="Left" Width="180" Height="20" Margin="10,250,0,0" VerticalAlignment="Top"/>
    </Grid>
</UserControl>
