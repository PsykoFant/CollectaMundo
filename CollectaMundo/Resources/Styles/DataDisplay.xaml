<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:CollectaMundo.Presentation.Behaviors">

    <!-- ============================================================
     DATAGRID STYLES
     ============================================================ -->

    <!-- DataGrid: Base -->
    <Style x:Key="DataGridBaseStyle" TargetType="{x:Type DataGrid}">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="EnableColumnVirtualization" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>

        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserSortColumns" Value="True"/>
        <Setter Property="CanUserResizeColumns" Value="True"/>

        <Setter Property="SelectionMode" Value="Extended"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>

        <Setter Property="HorizontalAlignment" Value="Stretch"/>

        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <!-- (optional) also: -->
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DataGrid: Card Grid Base -->
    <Style x:Key="CardGridBaseStyle" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource DataGridBaseStyle}">
        <!-- your attached behaviors (static values only) -->
        <Setter Property="behaviors:DataGridPersistSortBehavior.Enable" Value="True"/>
    </Style>

    <!-- DataGrid: Management -->
    <Style x:Key="ManagementGridStyle" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource DataGridBaseStyle}">
        <Setter Property="MinHeight" Value="40"/>
    </Style>

    <!-- DataGrid: Deck Builder Row -->
    <Style x:Key="DeckCardRowStyle"
       TargetType="{x:Type DataGridRow}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLegal}" Value="False">
                <Setter Property="Background" Value="#20D32F2F"/>
                <Setter Property="Foreground" Value="#FFB71C1C"/>
                <Setter Property="ToolTip" Value="This card is not legal in the selected format."/>
            </DataTrigger>

            <Trigger Property="IsSelected"
                 Value="True">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- DataGrid: Deck Cards -->
    <Style x:Key="DeckCardGridStyle" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource CardGridBaseStyle}">
        <Setter Property="RowStyle" Value="{StaticResource DeckCardRowStyle}"/>
        <Setter Property="ColumnWidth" Value="Auto"/>
    </Style>

    <!-- DataGrid: Deckbox -->
    <Style x:Key="DeckBoxDataGridStyle" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource CardGridBaseStyle}">
        <Setter Property="ColumnWidth" Value="Auto"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="RowBackground" Value="#F7F7F7"/>
        <Setter Property="AlternatingRowBackground" Value="#EEEEEE"/>
        <Setter Property="AlternationCount" Value="2"/>
    </Style>

    <!-- ============================================================
     DECK BUILDER STYLES
     ============================================================ -->

    <!-- Deck Builder: GroupBox -->
    <Style x:Key="DeckBuilderGroupBoxStyle"
       TargetType="{x:Type GroupBox}">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- ============================================================
     BUTTON STYLES
     ============================================================ -->

    <!-- Button: Quantity Stepper -->
    <Style x:Key="StepperButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Background" Value="#FFFBF7B4"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- ============================================================
     MENU STYLES
     ============================================================ -->

    <!-- MenuItem: Default Font -->
    <Style TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{StaticResource CollectaMundoFont}" />
    </Style>

    <!-- ============================================================
     DOCUMENT / TEXT DISPLAY STYLES
     ============================================================ -->

    <!-- FlowDocument: Default -->
    <Style TargetType="{x:Type FlowDocument}">
        <Setter Property="FontFamily" Value="{StaticResource CollectaMundoFont}"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- FlowDocumentScrollViewer: Default -->
    <Style TargetType="{x:Type FlowDocumentScrollViewer}">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
        <Setter Property="IsToolBarVisible" Value='False'/>
    </Style>

</ResourceDictionary>
