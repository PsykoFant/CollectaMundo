<UserControl x:Class="CollectaMundo.StatusOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="960" d:DesignWidth="1280"
             Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
             Style="{StaticResource {x:Type UserControl}}">
    <Grid>
        <Grid VerticalAlignment="Top" Margin="0,40,0,0">
            <Image Source="/Resources/Images/Logo.png"
                   Stretch="Fill"
                   HorizontalAlignment="Center"
                   Height="500"
                   Width="500"
                   Margin="0,76,0,0"/>

            <Label Content="CollectaMundo"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   FontSize="48"
                   Style="{StaticResource BelerenBold}"/>

            <ProgressBar Height="15"
                         Width="500"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top"
                         Margin="0,650,0,0"
                         BorderBrush="Black"
                         Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

            <Label Content="{Binding StatusMessage}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,621,0,0"/>

            <Label Content="{Binding FirstTimeSetupText}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,582,0,0"
                   Visibility="{Binding FirstTimeSetupText, Converter={StaticResource StringToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</UserControl>
