<UserControl x:Class="CollectaMundo.Views.ContentSection.Pages.PagesUtilitiesHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:rootViews="clr-namespace:CollectaMundo.Views"
             xmlns:pageViews="clr-namespace:CollectaMundo.Views.ContentSection.Pages"
             xmlns:cardLocationView="clr-namespace:CollectaMundo.Views.ContentSection.CardLocations"
             xmlns:importHost="clr-namespace:CollectaMundo.Views.ContentSection.Import"     
             xmlns:importVm="clr-namespace:CollectaMundo.ViewModels.Import"
             xmlns:utilitiesVm="clr-namespace:CollectaMundo.ViewModels.Utilities"
             xmlns:pagesVms="clr-namespace:CollectaMundo.ViewModels.Pages" 
             d:DataContext="{d:DesignInstance Type=pagesVms:PagesUtilitiesHostViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800">
    <Grid>
        <ContentControl Content="{Binding CurrentUtilitiesContentViewModel}">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type utilitiesVm:UtilitiesViewModel}"><pageViews:PagesUtilitiesHomeView /></DataTemplate>
                <DataTemplate DataType="{x:Type importVm:ImportViewModel}"><importHost:ImportWorkflowHost /></DataTemplate>
                <DataTemplate DataType="{x:Type utilitiesVm:CardLocationViewModel}"><cardLocationView:CardLocationView /></DataTemplate>
            </ContentControl.Resources>
        </ContentControl>

        <rootViews:OperationOverlayView DataContext="{Binding DataContext.OperationOverlayVM, RelativeSource={RelativeSource AncestorType=Window}}" Panel.ZIndex="100" />
    </Grid>
</UserControl>
