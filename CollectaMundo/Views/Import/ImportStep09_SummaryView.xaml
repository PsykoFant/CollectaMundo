<UserControl x:Class="CollectaMundo.Views.Import.ImportStep09_SummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vmsteps="clr-namespace:CollectaMundo.ViewModels.Import.ImportSteps"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vmsteps:ImportStep09_SummaryViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="800">

    <Grid Visibility="{Binding StepContentVisibility}"
          HorizontalAlignment="Center"
          Width="600"
          Margin="0,20,0,0">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Summary and confirmation" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,20" Style="{StaticResource BelerenBold}" />

        <!-- Summary counts -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="Number of individual cards that will be added:"
                       Style="{StaticResource BelerenBold}" />

            <TextBlock Grid.Row="0" Grid.Column="1"
                       Text="{Binding Summary.ReadyToImportCount}"
                       Margin="10,0,0,0"/>

            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="Total count of cards added to collection:"
                       Style="{StaticResource BelerenBold}" />

            <TextBlock Grid.Row="1" Grid.Column="1"
                       Text="{Binding Summary.TotalCardsToAdd}"
                       Margin="10,0,0,0"/>

            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="Number of cards not possible to import:"
                       Style="{StaticResource BelerenBold}" />

            <TextBlock Grid.Row="2" Grid.Column="1"
                       Text="{Binding Summary.UnableToImportCount}"
                       Margin="10,0,0,0"/>
        </Grid>

        <!-- Unimportable header -->
        <TextBlock Grid.Row="2"
                   Text="Unable to import the following cards:"
                   FontSize="16"
                   Style="{StaticResource BelerenBold}"
                   Visibility="{Binding Summary.UnableToImportCount, Converter={StaticResource CountToVisibilityConverter}}"
                   Margin="0,0,0,10"/>

        <!-- Save button (later wiring) -->
        <Button Grid.Row="3"
                Content="Save list to text file"
                Width="180"
                HorizontalAlignment="Right"
                Visibility="{Binding Summary.UnableToImportCount, Converter={StaticResource CountToVisibilityConverter}}"/>

        <!-- Unimportable items table -->
        <DataGrid Grid.Row="5"
                  ItemsSource="{Binding Summary.UnimportableItems}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  Visibility="{Binding Summary.UnableToImportCount,Converter={StaticResource CountToVisibilityConverter}}"
                  Margin="0,10,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Row"
                                    Binding="{Binding RowNumber}"
                                    Width="60"/>
                <DataGridTextColumn Header="Card Name"
                                    Binding="{Binding CardName}"
                                    Width="*"/>
                <DataGridTextColumn Header="Set Name"
                                    Binding="{Binding SetName}"
                                    Width="*"/>
                <DataGridTextColumn Header="Set Code"
                                    Binding="{Binding SetCode}"
                                    Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</UserControl>
