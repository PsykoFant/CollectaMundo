<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sharedElements="clr-namespace:CollectaMundo.Views.ContentSection.Pages.SharedElements">
    
    
    <DataTemplate x:Key="DeckCardNameCellTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       Foreground="DarkRed"
                       FontSize="16"
                       Text="⚠"
                       ToolTip="This card is not legal in the selected format">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLegal}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Grid.Column="1" Text="{Binding CardName}" TextWrapping="Wrap"/>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="DeckCardManaCostCellTemplate"> 
        <Image Source="{Binding ManaCostImage}" Height="20" HorizontalAlignment="Right"/>
    </DataTemplate>

    <DataTemplate x:Key="DeckCardTypeCellTemplate">
        <TextBlock Text="{Binding Type}" TextWrapping="Wrap"/>
    </DataTemplate>

    <DataTemplate x:Key="DeckCardOwnedCellTemplate">
        <TextBlock Text="{Binding OwnedQuantity}" TextWrapping="Wrap" HorizontalAlignment="Stretch" TextAlignment="Center"/>
    </DataTemplate>

    <DataTemplate x:Key="DeckCardAvailableCellTemplate">
        <TextBlock Text="{Binding AvailableQuantity}" TextWrapping="Wrap" HorizontalAlignment="Stretch" TextAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasInsufficientAvailableQuantity}" Value="True">
                            <Setter Property="Background" Value="LightCoral"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="ToolTip" Value="Not enough available copies to build the deck."/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </DataTemplate>

    <DataTemplate x:Key="DeckCardAllocatedCellTemplate">
        <TextBlock Text="{Binding AllocatedQuantity}" TextWrapping="Wrap" HorizontalAlignment="Stretch" TextAlignment="Center"/>
    </DataTemplate>

    <DataTemplate x:Key="DeckCardIncrementCellTemplate">
        <Button Content="+"
                Style="{StaticResource StepperButtonStyle}"
                Command="{Binding DataContext.IncrementDeckCardQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                CommandParameter="{Binding}"/>
    </DataTemplate>

    <DataTemplate x:Key="DeckCardQuantityCellTemplate">
        <sharedElements:NumericEditorUserControl DataContext="{Binding DesiredQuantityBinding}"/>
    </DataTemplate>

    <DataTemplate x:Key="DeckCardDecrementCellTemplate">
        <Button Content="-"
                Style="{StaticResource StepperButtonStyle}"
                Command="{Binding DataContext.DecrementDeckCardQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                CommandParameter="{Binding}"/>
    </DataTemplate>

</ResourceDictionary>
