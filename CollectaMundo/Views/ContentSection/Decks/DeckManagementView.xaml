<UserControl x:Class="CollectaMundo.Views.ContentSection.Decks.DeckManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:CollectaMundo.Presentation.Behaviors"
             xmlns:deckManagement="clr-namespace:CollectaMundo.ViewModels.Decks"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=deckManagement:DeckManagementViewModel}"
             d:Style="{StaticResource {x:Type UserControl}}"             
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelOrClearSelectionCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="16" Background="Transparent">
        <i:Interaction.Behaviors>
            <behaviors:ClearSelectionOnBackgroundClickBehavior Command="{Binding ClearSelectionAndRestoreCreateModeCommand}" />
        </i:Interaction.Behaviors>        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Page title -->
            <RowDefinition Height="Auto"/>  <!-- Section header -->
            <RowDefinition Height="Auto"/>  <!-- Form for adding/editing deck -->
            <RowDefinition Height="30"/>    <!-- Status message -->
            <RowDefinition Height="45"/>    <!-- Edit deck button -->
            <RowDefinition Height="*"/>     <!-- Data grid  -->
        </Grid.RowDefinitions>

        <!-- Page title -->
        <Label Grid.Row="0" Content="Manage Decks" Style="{StaticResource BigHeaderLabelStyle}" />

        <!-- Section header -->
        <Label Grid.Row="1" Content="{Binding ModeMessage}" Style="{StaticResource SmallHeaderLabelStyle}" />

        <!-- Form for adding/editing deck -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0" Width="350" HorizontalAlignment="Center">

            <Label Content="Deck name:" />
            <TextBox Text="{Binding DeckName, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsSingleItemTextEditorEnabled}"
                     Margin="0,0,0,10">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter"
                    Command="{Binding SubmitCommand}" />
                </TextBox.InputBindings>
            </TextBox>

            <Label Content="Format:" />
            <ComboBox ItemsSource="{Binding DeckFormats}"
                      DisplayMemberPath="DisplayName"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding SelectedDeckFormat, Mode=TwoWay}"
                      IsEnabled="{Binding IsDiscreteValueEditorEnabled}"
                      Margin="0,0,0,10" />

            <Label Content="Description:" />
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsSingleItemTextEditorEnabled}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     MinHeight="70"
                     MaxHeight="90"
                     Margin="0,0,0,14" />

            <Grid>
                <Button Content="{Binding ActionButtonText}"
                        Command="{Binding SubmitCommand}"
                        IsEnabled="{Binding IsActionButtonEnabled}" 
                        Width="125"
                        Height="20"
                        HorizontalAlignment="Left" />

                <Button Content="Cancel"
                        Command="{Binding CancelEditCommand}"
                        Width="60"
                        Height="20"
                        HorizontalAlignment="Center"
                        Visibility="{Binding IsCancelVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

                <Button Content="{Binding DeleteButtonText}"
                        Command="{Binding DeleteSelectedDecksCommand}"
                        Width="100"
                        Height="20"
                        HorizontalAlignment="Right"
                        Visibility="{Binding HasSelectedItems, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </StackPanel>

        <!-- Status message -->
        <TextBlock Grid.Row="3"
                   Margin="0,16,0,0"
                   Text="{Binding StatusMessage}"
                   Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap" />
        
        <!-- Edit deck button -->
        <Button Grid.Row="4"
                Content="Enter Deck Builder" 
                Margin="0,5,0,5"
                Style="{StaticResource TopMenuButtonStyle}"
                IsEnabled="{Binding IsEditDeckButtonEnabled}"
                Command="{Binding EnterDeckBuilderCommand}"
                Visibility="{Binding HasSelectedItems, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!-- Data grid for displaying decks -->
        
        <DataGrid Grid.Row="5"
                  ItemsSource="{Binding Decks}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  behaviors:DataGridSelectedItemsBehavior.SyncedSelectedItems="{Binding SelectedItems}"
                  behaviors:DataGridClearSelectionBehavior.ClearSelectionTrigger="{Binding ClearSelectionTrigger}"
                  Style="{StaticResource ManagementGridStyle}">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDoubleClick">
                    <i:InvokeCommandAction Command="{Binding EnterDeckBuilderCommand}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name"
                                    Width="2*"
                                    Binding="{Binding Name}" />

                <DataGridTextColumn Header="Format"
                                    Width="110"
                                    Binding="{Binding FormatDisplayName}" />

                <DataGridTextColumn Header="Description"
                                    Width="3*"
                                    Binding="{Binding Description}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
