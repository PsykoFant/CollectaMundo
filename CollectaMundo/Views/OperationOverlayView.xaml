<UserControl x:Class="CollectaMundo.Views.OperationOverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:CollectaMundo.ViewModels.Shared"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:OperationOverlayViewModel}"
             Visibility="{Binding IsOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}"
             Style="{StaticResource {x:Type UserControl}}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Big Header -->
            <RowDefinition Height="Auto"/> <!-- Graphics -->
            <RowDefinition Height="Auto"/> <!-- Progressbar -->
            <RowDefinition Height="Auto"/> <!-- Step headline -->
            <RowDefinition Height="Auto"/> <!-- Step stepname -->
            <RowDefinition Height="Auto"/> <!-- Step detail -->
            <RowDefinition Height="Auto"/> <!-- Primary Action Button -->
            <RowDefinition Height="*"/> <!-- Secondary Action Button -->
        </Grid.RowDefinitions>

        <!-- Big Header -->
        <Label Grid.Row="0" Content="CollectaMundo" HorizontalAlignment="Center" Style="{StaticResource BigHeaderLabelStyle}" />

        <!-- Graphics -->
        <Image Grid.Row="1"
               Source="/Resources/Images/Logo.png"
               Visibility="{Binding IsLogoVisible, Converter={StaticResource BoolToVisibilityConverter}}"
               Stretch="Fill"
               HorizontalAlignment="Center"
               Height="300"
               Width="300"
               Margin="0,0,0,30"/>

        <Image Grid.Row="1"
               Source="/Resources/Images/counterspell_fail.png"
               Visibility="{Binding IsSetupFailVisible, Converter={StaticResource BoolToVisibilityConverter}}"
               Stretch="None"
               HorizontalAlignment="Center"
               Height="300"
               Width="300"
               Margin="0,0,0,30"/>

        <!-- Progressbar -->
        <ProgressBar Grid.Row="2"
                     Value="{Binding ProgressValue}"
                     Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                     Margin="0,0,0,20"
                     Style="{StaticResource CollectaMundoProgressBarStyle}" />

        <!-- Step headline -->
        <Label Grid.Row="3" Content="{Binding Headline}" HorizontalAlignment="Center" Style="{StaticResource SmallHeaderLabelStyle}" />

        <!-- Step stepname -->
        <Label Grid.Row="4" Content="{Binding Step}" HorizontalAlignment="Center"/>

        <!-- Step detail -->
        <Label Grid.Row="5" Content="{Binding Detail}" HorizontalAlignment="Center"/>

        <!-- Primary Action Button -->
        <Button Grid.Row="6"
                Command="{Binding PrimaryActionCommand}"
                Content="{Binding PrimaryButtonText}" 
                Visibility="{Binding IsPrimaryButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                Margin="40,20,40,20"
                HorizontalAlignment="Center" VerticalAlignment="Top"/>

        <!-- Secondary Action Button -->
        <Button Grid.Row="7"
                Command="{Binding SecondaryActionCommand}"
                Content="{Binding SecondaryButtonText}" 
                Visibility="{Binding IsSecondaryButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                Margin="40,10,40,20"
                HorizontalAlignment="Center" VerticalAlignment="Top"/>
    </Grid>
</UserControl>
