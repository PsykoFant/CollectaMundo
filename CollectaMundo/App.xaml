<Application x:Class="CollectaMundo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodelsPages="clr-namespace:CollectaMundo.ViewModels.Pages"    
             xmlns:converters="clr-namespace:CollectaMundo.Presentation.Converters"
             
             
             xmlns:local="clr-namespace:CollectaMundo">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Converters.xaml" />
                <ResourceDictionary Source="Resources/Styles/Theme.xaml" />
                <ResourceDictionary Source="Resources/Styles/Typography.xaml" />
                <ResourceDictionary Source="Resources/Styles/Buttons.xaml" />
                <ResourceDictionary Source="Resources/Styles/Inputs.xaml" />
                <ResourceDictionary Source="Resources/Styles/DataDisplay.xaml" />
                <ResourceDictionary Source="Resources/Styles/Shell.xaml" />
                <ResourceDictionary Source="Resources/Styles/Filters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
