                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Set" Width="*" SortMemberPath="SetName">
