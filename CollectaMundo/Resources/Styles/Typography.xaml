<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="BelerenBold">
        <Setter Property="TextElement.FontFamily" Value="{StaticResource CollectaMundoHeaderFont}" />
    </Style>

    <!-- Header font styles -->
    <Style x:Key="BaseHeaderLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource CollectaMundoHeaderFont}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="BigHeaderLabelStyle" TargetType="Label" BasedOn="{StaticResource BaseHeaderLabelStyle}">
        <Setter Property="FontSize" Value="48" />
    </Style>

    <Style x:Key="MediumHeaderLabelStyle" TargetType="Label" BasedOn="{StaticResource BaseHeaderLabelStyle}">
        <Setter Property="FontSize" Value="24" />
    </Style>

    <Style x:Key="SmallHeaderLabelStyle" TargetType="Label" BasedOn="{StaticResource BaseHeaderLabelStyle}">
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- FlowDocument font style -->
    <Style TargetType="{x:Type FlowDocument}">
        <Setter Property="FontFamily" Value="{StaticResource CollectaMundoFont}"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- MenuItem font style -->
    <Style TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{StaticResource CollectaMundoFont}" />
    </Style>


</ResourceDictionary>
