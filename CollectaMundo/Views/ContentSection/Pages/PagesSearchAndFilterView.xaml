<UserControl x:Class="CollectaMundo.Views.ContentSection.Pages.PagesSearchAndFilterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:pagesVm="clr-namespace:CollectaMundo.ViewModels.Pages"
             xmlns:sharedElements="clr-namespace:CollectaMundo.Views.ContentSection.Pages.SharedElements"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:CollectaMundo.Presentation.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=pagesVm:PagesSearchAndFilterViewModel, IsDesignTimeCreatable=False}"
             d:Style="{StaticResource {x:Type UserControl}}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="270"/>   <!-- 0 - Top Panel -->
            <RowDefinition Height="25"/>    <!-- 1 - Actions -->
            <RowDefinition Height="*"/>     <!-- 2 - Data Grid -->
        </Grid.RowDefinitions>

        <!-- 0 - Top Panel -->
        <sharedElements:CardListPageTopPanelUserControl Grid.Row="0" />

        <!-- 1 - Actions -->
        <Button Grid.Row="1"
                Content="Add selected cards to my collection"
                HorizontalAlignment="Right" 
                VerticalAlignment="Top"
                Width="200" Height="20"
                Visibility="{Binding ElementName=AllCardsDataGrid, Path=SelectedItems.Count, Converter={StaticResource CountToVisibilityConverter}}"
                Command="{Binding ModifyCollectionViewModel.AddSelectedCardsCommand}"
                CommandParameter="{Binding SelectedItems, ElementName=AllCardsDataGrid}" />

        <!-- 2 - Data Grid -->
        <DataGrid Grid.Row="2"
                  x:Name="AllCardsDataGrid"
                  ItemsSource="{Binding CardsVM.FilteredCards, NotifyOnTargetUpdated=True}"
                  Style="{StaticResource CardGridBaseStyle}" 
                  SelectedItem="{Binding CardImageVM.SelectedCard, Mode=TwoWay}"                  
                  behaviors:DataGridClearSelectionBehavior.ClearSelectionTrigger="{Binding ModifyCollectionViewModel.ClearSelectionTrigger, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="Name">                    
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <sharedElements:FilterHeaderUserControl DataContext="{Binding DataContext.NameFilter, ElementName=AllCardsDataGrid}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Set Name" Width="*" SortMemberPath="SetName">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <sharedElements:FilterHeaderUserControl DataContext="{Binding DataContext.SetNameFilter, ElementName=AllCardsDataGrid}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SetName}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>                
                <DataGridTemplateColumn Header="Icon" IsReadOnly="True" Width="Auto" SortMemberPath="ReleaseDate">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding KeyRuneImage}" Width="20" Height="20" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Mana Cost" IsReadOnly="True" Width="Auto" SortMemberPath="ManaValue">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding ManaCostImage}" Height="20" HorizontalAlignment="Right"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Card Types" Width="*" SortMemberPath="Type">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Type}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Finishes" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Finishes}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn SortMemberPath="NormalPrice" Width="*">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DataContext.PricesVM.PriceHeader, ElementName=AllCardsDataGrid}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding NormalPrice}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn SortMemberPath="FoilPrice" Width="*">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DataContext.PricesVM.FoilPriceHeader, ElementName=AllCardsDataGrid}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FoilPrice}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn SortMemberPath="EtchedPrice" Width="*">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DataContext.PricesVM.EtchedPriceHeader, ElementName=AllCardsDataGrid}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding EtchedPrice}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDoubleClick">
                    <i:InvokeCommandAction 
                                    Command="{Binding ModifyCollectionViewModel.AddSelectedCardsCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=AllCardsDataGrid}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Add selected card(s) to Collection"
                              Command="{Binding ModifyCollectionViewModel.AddSelectedCardsCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="Add selected card(s) with DEFAULT values to Collection"
                              Command="{Binding ModifyCollectionViewModel.SubmitNewCardsWithDefaultsCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              Style="{StaticResource BelerenBold}"/>
                    <MenuItem Header="">
                        <MenuItem.Template>
                            <ControlTemplate>
                                <Label Content="Default values are:" Margin="30,0,0,0"/>
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                    <MenuItem Header="">
                        <MenuItem.Template>
                            <ControlTemplate>
                                <Label Content=" - Condition: Near Mint" Margin="30,0,0,0"/>
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                    <MenuItem Header="">
                        <MenuItem.Template>
                            <ControlTemplate>
                                <Label Content=" - Language: English" Margin="30,0,0,0"/>
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                    <MenuItem Header="">
                        <MenuItem.Template>
                            <ControlTemplate>
                                <Label Content=" - Finish: nonfoil" Margin="30,0,0,0"/>
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                    <MenuItem Header="">
                        <MenuItem.Template>
                            <ControlTemplate>
                                <Label Content=" - Count: 1" Margin="30,0,0,0"/>
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                    <MenuItem Header="">
                        <MenuItem.Template>
                            <ControlTemplate>
                                <Label Content=" - Trade: 0" Margin="30,0,0,0"/>
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>
</UserControl>
