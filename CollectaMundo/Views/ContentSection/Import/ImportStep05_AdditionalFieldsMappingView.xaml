<UserControl x:Class="CollectaMundo.Views.ContentSection.Import.ImportStep05_AdditionalFieldsMappingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vmsteps="clr-namespace:CollectaMundo.ViewModels.Import.ImportSteps"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vmsteps:ImportStep05_AdditionalFieldsMappingViewModel}"
             d:Style="{StaticResource {x:Type UserControl}}"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Visibility="{Binding IsStepContentVisible, Converter={StaticResource BoolToVisibilityConverter}}" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <!-- Explainer -->
            <RowDefinition Height="Auto"/>
            <!-- Listview -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <FlowDocumentScrollViewer Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Center">
            <FlowDocument>
                <Paragraph>
                    Cards will be imported with the following default values if mapping is blank:
                </Paragraph>
                <List MarkerStyle="Disc" Margin="0,10,0,0">
                    <ListItem>
                        <Paragraph>
                            Condition: "Near Mint"
                        </Paragraph>
                    </ListItem>
                    <ListItem>
                        <Paragraph>
                            Card Finish: "nonfoil"
                        </Paragraph>
                    </ListItem>
                    <ListItem>
                        <Paragraph>
                            Cards Owned: "1"
                        </Paragraph>
                    </ListItem>
                    <ListItem>
                        <Paragraph>
                            Cards For Trade/Selling: "0"
                        </Paragraph>
                    </ListItem>
                    <ListItem>
                        <Paragraph>
                            Language: "English"
                        </Paragraph>
                    </ListItem>
                    <ListItem>
                        <Paragraph>
                            Location: blank (no location)
                        </Paragraph>
                    </ListItem>
                    <ListItem>
                        <Paragraph>
                            Comment: blank (no comments)
                        </Paragraph>
                    </ListItem>                    
                </List>
            </FlowDocument>
        </FlowDocumentScrollViewer>
        <ListView Grid.Row="1" ItemsSource="{Binding AdditionalMappings}" HorizontalAlignment="Center" VerticalAlignment="Top">
            <ListView.View>
                <GridView>
                    <!-- Left: Domain field -->
                    <GridViewColumn Header="Field to map" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FieldToMap}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Middle: CSV column -->
                    <GridViewColumn Header="Import file header" Width="220">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding CsvHeaders}"
                                  SelectedItem="{Binding SelectedCsvHeader, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Right: Clear button -->
                    <GridViewColumn Header="Reset" Width="110">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="   Clear   "
                                Command="{Binding DataContext.ClearSelectedMappingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>


