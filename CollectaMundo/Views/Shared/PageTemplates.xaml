<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pageViews="clr-namespace:CollectaMundo.Views.Pages"
                    xmlns:sideMenuLeftViews="clr-namespace:CollectaMundo.Views.SideMenuLeft"
                    xmlns:vmPages="clr-namespace:CollectaMundo.ViewModels.Pages"
                    xmlns:vmSideMenuLeft="clr-namespace:CollectaMundo.ViewModels.SideMenuLeft">

    <DataTemplate DataType="{x:Type vmPages:PagesSearchAndFilterViewModel}">
        <pageViews:SearchAndFilterPageView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vmPages:PagesMyCollectionViewModel}">
        <pageViews:MyCollectionPageView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vmPages:PagesUtilitiesViewModel}">
        <pageViews:UtilitiesPageView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vmSideMenuLeft:SideMenuFilteringViewModel}">
        <sideMenuLeftViews:FilteringSideMenuView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vmSideMenuLeft:SideMenuUtilitiesViewModel}">
        <sideMenuLeftViews:UtilitiesSideMenuView />
    </DataTemplate>

</ResourceDictionary>
