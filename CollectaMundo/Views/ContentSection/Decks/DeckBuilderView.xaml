<UserControl x:Class="CollectaMundo.Views.ContentSection.Decks.DeckBuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:CollectaMundo.Presentation.Behaviors"
             xmlns:deckPresentation="clr-namespace:CollectaMundo.Presentation.Decks"
             xmlns:deckViewModels="clr-namespace:CollectaMundo.ViewModels.Decks"
             xmlns:sharedElements="clr-namespace:CollectaMundo.Views.ContentSection.Pages.SharedElements"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=deckViewModels:DeckBuilderViewModel}"
             d:Style="{StaticResource {x:Type UserControl}}"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <AdornerDecorator>
        <Grid Margin="10" Background="Transparent">
            <i:Interaction.Behaviors>
                <behaviors:ClearSelectionOnBackgroundClickBehavior Command="{Binding ClearSelectionsCommand}" />
            </i:Interaction.Behaviors>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 0 - Header + back button -->
                <RowDefinition Height="5*"/>    <!-- 1 - upper deck-builder area -->
                <RowDefinition Height="Auto"/>  <!-- 2 - Filter criteria summary -->
                <RowDefinition Height="40"/>    <!-- 3 - Add-buttons -->
                <RowDefinition Height="Auto"/>  <!-- 4 - In the deckbox -->
                <RowDefinition Height="3*"/>    <!-- 5 - Bottom: Filterable oracle card source -->
            </Grid.RowDefinitions>

            <!-- 0 - Header + back button -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <Label DockPanel.Dock="Left" Content="{Binding DeckName}" Style="{StaticResource MediumHeaderLabelStyle}"/>

                <Button Content="Back to Decks"
                    Width="120"
                    Height="24"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Command="{Binding BackToDeckManagementCommand}"/>
            </DockPanel>

            <!-- 1 - upper deck-builder area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left column: Deck / Sideboard / Maybeboard scroll together -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <i:Interaction.Behaviors>
                        <behaviors:ScrollViewerMouseWheelBehavior/>
                    </i:Interaction.Behaviors>
                    <StackPanel>
                        
                        <!-- Deck -->
                        <GroupBox>
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Maindeck"/>
                                    <TextBlock Text=" ⓘ" Margin="4,0,0,0" Opacity="0.65"
                                               ToolTip="Drag cards between deck zones. Hold Shift while dragging to move all copies of each selected card. Dropping outside a valid zone removes cards."/>
                                </StackPanel>
                            </GroupBox.Header>
                            <DataGrid x:Name="DeckCardsDataGrid" 
                                      ItemsSource="{Binding MainboardZone.Cards}" 
                                      SelectedItem="{Binding SelectedDeckCard, Mode=TwoWay}" 
                                      Style="{StaticResource DeckCardGridStyle}"
                                      behaviors:ColumnWidthRefreshBehavior.RefreshTrigger="{Binding RefreshColumnsTrigger}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Card Name" Width="*" SortMemberPath="CardName" CellTemplate="{StaticResource DeckCardNameCellTemplate}"/>
                                    <DataGridTemplateColumn Header="Mana Cost" SortMemberPath="ManaValue" CellTemplate="{StaticResource DeckCardManaCostCellTemplate}"/>
                                    <DataGridTemplateColumn Header="Card types" SortMemberPath="Type" CellTemplate="{StaticResource DeckCardTypeCellTemplate}"/>
                                    <DataGridTemplateColumn SortMemberPath="OwnedQuantity" CellTemplate="{StaticResource DeckCardOwnedCellTemplate}">
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="📦" ToolTip="{x:Static deckPresentation:DeckBuilderTooltips.Owned}"/>
                                        </DataGridTemplateColumn.Header>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn SortMemberPath="AvailableQuantity" CellTemplate="{StaticResource DeckCardAvailableCellTemplate}">
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="🔓" ToolTip="{x:Static deckPresentation:DeckBuilderTooltips.Available}"/>
                                        </DataGridTemplateColumn.Header>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn SortMemberPath="AllocatedQuantity" CellTemplate="{StaticResource DeckCardAllocatedCellTemplate}">
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="📍" ToolTip="{x:Static deckPresentation:DeckBuilderTooltips.Allocated}"/>
                                        </DataGridTemplateColumn.Header>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="+" CellTemplate="{StaticResource DeckCardIncrementCellTemplate}"/>
                                    <DataGridTemplateColumn SortMemberPath="DesiredQuantityBinding" CellTemplate="{StaticResource DeckCardQuantityCellTemplate}">
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="#" ToolTip="{x:Static deckPresentation:DeckBuilderTooltips.DesiredQuantity}"/>
                                        </DataGridTemplateColumn.Header>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="-" CellTemplate="{StaticResource DeckCardDecrementCellTemplate}"/>
                                </DataGrid.Columns>
                                
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Remove from deck" 
                                                  Command="{Binding PlacementTarget.DataContext.DeleteDeckCardsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.InputBindings>
                                    <KeyBinding Key="Delete" Command="{Binding DeleteDeckCardsCommand}" CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                </DataGrid.InputBindings>
                                <i:Interaction.Behaviors>
                                    <behaviors:DeckBuilderDragDeckCardBehavior DestinationSection="Mainboard" 
                                                                               DragCommand="{Binding HandleDeckCardDragCommand}"
                                                                               AddOracleCardCommand="{Binding AddDraggedOracleCardCommand}"/>
                                </i:Interaction.Behaviors>
                            </DataGrid>
                        </GroupBox>
                        
                        <!-- Sideboard -->
                        <GroupBox Header="Sideboard">
                            <DataGrid x:Name="SideboardDataGrid"
                                      ItemsSource="{Binding SideboardZone.Cards}"
                                      SelectedItem="{Binding SelectedDeckCard, Mode=TwoWay}"
                                      Style="{StaticResource DeckCardGridStyle}"
                                      behaviors:ColumnWidthRefreshBehavior.RefreshTrigger="{Binding RefreshColumnsTrigger}">

                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Card Name" Width="*" SortMemberPath="CardName" CellTemplate="{StaticResource DeckCardNameCellTemplate}"/>
                                    <DataGridTemplateColumn Header="Mana Cost" SortMemberPath="ManaValue" CellTemplate="{StaticResource DeckCardManaCostCellTemplate}"/>
                                    <DataGridTemplateColumn Header="+" CellTemplate="{StaticResource DeckCardIncrementCellTemplate}"/>
                                    <DataGridTemplateColumn SortMemberPath="DesiredQuantityBinding" CellTemplate="{StaticResource DeckCardQuantityCellTemplate}">
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="#" ToolTip="{x:Static deckPresentation:DeckBuilderTooltips.DesiredQuantity}"/>
                                        </DataGridTemplateColumn.Header>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="-" CellTemplate="{StaticResource DeckCardDecrementCellTemplate}"/>
                                </DataGrid.Columns>

                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Remove from sideboard" Command="{Binding PlacementTarget.DataContext.DeleteDeckCardsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.InputBindings>
                                    <KeyBinding Key="Delete" Command="{Binding DeleteDeckCardsCommand}"  CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                </DataGrid.InputBindings>
                                <i:Interaction.Behaviors>
                                    <behaviors:DeckBuilderDragDeckCardBehavior DestinationSection="Sideboard" 
                                                                        DragCommand="{Binding HandleDeckCardDragCommand}"
                                                                        AddOracleCardCommand="{Binding AddDraggedOracleCardCommand}"/>
                                </i:Interaction.Behaviors>
                            </DataGrid>
                        </GroupBox>

                        <!-- Maybeboard -->
                        <GroupBox Header="Maybeboard">
                            <DataGrid x:Name="MaybeboardDataGrid" 
                                      ItemsSource="{Binding MaybeboardZone.Cards}" 
                                      SelectedItem="{Binding SelectedDeckCard, Mode=TwoWay}" 
                                      Style="{StaticResource DeckCardGridStyle}"
                                      behaviors:ColumnWidthRefreshBehavior.RefreshTrigger="{Binding RefreshColumnsTrigger}">

                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Card Name" Width="*" SortMemberPath="CardName" CellTemplate="{StaticResource DeckCardNameCellTemplate}"/>
                                    <DataGridTemplateColumn Header="Mana Cost" SortMemberPath="ManaValue" CellTemplate="{StaticResource DeckCardManaCostCellTemplate}"/>
                                    <DataGridTemplateColumn Header="Card types" SortMemberPath="Type" CellTemplate="{StaticResource DeckCardTypeCellTemplate}"/>
                                    <DataGridTemplateColumn Header="+" CellTemplate="{StaticResource DeckCardIncrementCellTemplate}"/>
                                    <DataGridTemplateColumn SortMemberPath="DesiredQuantityBinding" CellTemplate="{StaticResource DeckCardQuantityCellTemplate}">
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="#" ToolTip="{x:Static deckPresentation:DeckBuilderTooltips.DesiredQuantity}"/>
                                        </DataGridTemplateColumn.Header>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="-" CellTemplate="{StaticResource DeckCardDecrementCellTemplate}"/>
                                </DataGrid.Columns>

                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Remove from maybeboard" Command="{Binding PlacementTarget.DataContext.DeleteDeckCardsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.InputBindings>
                                    <KeyBinding Key="Delete" Command="{Binding DeleteDeckCardsCommand}" CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                </DataGrid.InputBindings>
                                <i:Interaction.Behaviors>
                                    <behaviors:DeckBuilderDragDeckCardBehavior DestinationSection="Maybeboard" 
                                                                        DragCommand="{Binding HandleDeckCardDragCommand}"
                                                                        AddOracleCardCommand="{Binding AddDraggedOracleCardCommand}"/>
                                </i:Interaction.Behaviors>
                            </DataGrid>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>

                <!-- Right column: stays fixed within the upper 60% -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Stats -->
                    <GroupBox Grid.Row="0" Header="Stats">
                        <StackPanel>
                            <TextBlock Text="Types" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding Stats.TypeBreakdown}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="75"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Label}"/>

                                            <ProgressBar Grid.Column="1"
                                                         Height="10"
                                                         Margin="4,0"
                                                         Minimum="0"
                                                         Maximum="{Binding DataContext.Stats.CardCount, RelativeSource={RelativeSource AncestorType=GroupBox}}"
                                                         Value="{Binding Count}"
                                                         Background="Transparent"
                                                         BorderBrush="Transparent"/>

                                            <TextBlock Grid.Column="2" Text="{Binding Count}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Row 0 -->
                                <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Cards"
                                   FontWeight="SemiBold"/>

                                <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   Margin="8,0,0,0"
                                   Text="{Binding Stats.CardCount}"/>

                                <TextBlock Grid.Row="0"
                                   Grid.Column="3"
                                   Text="Lands"
                                   FontWeight="SemiBold"/>

                                <TextBlock Grid.Row="0"
                                   Grid.Column="4"
                                   Margin="8,0,0,0"
                                   Text="{Binding Stats.LandCount}"/>

                                <TextBlock Grid.Row="0"
                                   Grid.Column="5"
                                   Margin="6,0,0,0"
                                   Text="{Binding Stats.LandPercentage, StringFormat={}{0:0}%}"/>

                                <!-- Row 1 -->
                                <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Margin="0,4,0,0"
                                   Text="Creatures"
                                   FontWeight="SemiBold"/>

                                <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Margin="8,4,0,0"
                                   Text="{Binding Stats.CreatureCount}"/>

                                <TextBlock Grid.Row="1"
                                   Grid.Column="2"
                                   Margin="6,4,0,0"
                                   Text="{Binding Stats.CreaturePercentage, StringFormat={}{0:0}%}"/>

                                <TextBlock Grid.Row="1"
                                   Grid.Column="3"
                                   Margin="0,4,0,0"
                                   Text="Spells"
                                   FontWeight="SemiBold"/>

                                <TextBlock Grid.Row="1"
               Grid.Column="4"
               Margin="8,4,0,0"
               Text="{Binding Stats.SpellCount}"/>

                                <TextBlock Grid.Row="1"
               Grid.Column="5"
               Margin="6,4,0,0"
               Text="{Binding Stats.SpellPercentage, StringFormat={}{0:0}%}"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- Command zone -->
                    <GroupBox Grid.Row="1" Header="Command zone" Visibility="{Binding IsCommanderZoneVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DataGrid x:Name="CommanderDataGrid" ItemsSource="{Binding CommanderZone.Cards}"
                                  SelectedItem="{Binding SelectedDeckCard, Mode=TwoWay}"
                                  Style="{StaticResource DeckCardGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Card Name" Width="*" SortMemberPath="CardName" CellTemplate="{StaticResource DeckCardNameCellTemplate}"/>
                                <DataGridTemplateColumn Header="Mana Cost" Width="Auto" SortMemberPath="ManaValue" CellTemplate="{StaticResource DeckCardManaCostCellTemplate}"/>
                            </DataGrid.Columns>
                            
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Fire commander"
                                              Command="{Binding PlacementTarget.DataContext.DeleteDeckCardsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.InputBindings>
                                <KeyBinding Key="Delete"
                                            Command="{Binding DeleteDeckCardsCommand}"
                                            CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataGrid.InputBindings>
                        </DataGrid>
                    </GroupBox>
                    
                    <!-- Companion zone -->
                    <GroupBox Grid.Row="2" Header="Companion zone" Visibility="{Binding IsCompanionZoneVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DataGrid x:Name="CompanionDataGrid"
                                  ItemsSource="{Binding CompanionZone.Cards}"
                                  SelectedItem="{Binding SelectedDeckCard, Mode=TwoWay}"
                                  Style="{StaticResource DeckCardGridStyle}">
                            
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Card Name" Width="*" SortMemberPath="CardName" CellTemplate="{StaticResource DeckCardNameCellTemplate}"/>
                                <DataGridTemplateColumn Header="Mana Cost" Width="Auto" SortMemberPath="ManaValue" CellTemplate="{StaticResource DeckCardManaCostCellTemplate}"/>
                            </DataGrid.Columns>
                            
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Remove companion"
                                              Command="{Binding PlacementTarget.DataContext.DeleteDeckCardsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.InputBindings>
                                <KeyBinding Key="Delete"
                                            Command="{Binding DeleteDeckCardsCommand}"
                                            CommandParameter="{Binding SelectedItems,RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            </DataGrid.InputBindings>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </Grid>

            <!-- 2 - Filter criteria summary -->
            <Grid Grid.Row="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <TextBlock TextWrapping="Wrap" Text="{Binding FilterVM.FilterSummary}" HorizontalAlignment="Center"/>
                </ScrollViewer>
            </Grid>

            <!-- 3 - Add-buttons -->
            <Grid Grid.Row="3" Margin="0,10,0,10">
                <StackPanel HorizontalAlignment ="Right" Orientation="Horizontal">
                    <Button Content="  Set as Companion  "
                        Height="20"
                        Margin="0,0,6,0"
                        Visibility="{Binding CanSetSelectedOracleCardAsCompanion, Converter={StaticResource BoolToVisibilityConverter}}"
                        Command="{Binding SetOracleCardAsCompanionCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=AvailableCardsDataGrid}"/>

                    <Button Content="  Set as Commander  "
                        Height="20"
                        Margin="0,0,6,0"
                        Visibility="{Binding CanSetSelectedOracleCardAsCommander, Converter={StaticResource BoolToVisibilityConverter}}"
                        Command="{Binding SetOracleCardAsCommanderCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=AvailableCardsDataGrid}"/>

                    <Button Content="  + 1 to Maybeboard  "
                        Visibility="{Binding IsAddButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        Height="20"
                        Margin="0,0,6,0"
                        Command="{Binding AddOracleCardToMaybeboardCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=AvailableCardsDataGrid}"/>

                    <Button Content="  + 1 to sideboard  "
                        Visibility="{Binding IsAddButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        Height="20"
                        Margin="0,0,6,0"
                        Command="{Binding AddOracleCardToSideboardCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=AvailableCardsDataGrid}"/>

                    <Button Content="  + 4 to deck  "
                        Visibility="{Binding IsAddButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        Height="20"
                        Margin="0,0,6,0"
                        Command="{Binding AddOracleCardPlaySetToDeckCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=AvailableCardsDataGrid}"/>

                    <Button Content="  + 1 to deck  "
                        Visibility="{Binding IsAddButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        Height="20"
                        Command="{Binding AddOracleCardToDeckCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=AvailableCardsDataGrid}"/>

                </StackPanel>
            </Grid>

            <!-- 4 - In the deckbox -->
            <GroupBox Grid.Row="4" Margin="0,6,0,6" Visibility="{Binding IsDeckBoxDataGridVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="In the deckbox: Allocated from collection "/>
                        <TextBlock Text=" ⓘ" Margin="4,0,0,0" Opacity="0.65"
                                   ToolTip="Cards currently allocated to this deck location. Drag selected cards to a deck zone to add them to the deck list. Hold Shift while dragging to add 4 copies of each. Moving or removing cards in the deck list does not change their collection location."/>
                    </StackPanel>
                </GroupBox.Header>
                    <DataGrid ItemsSource="{Binding DeckBoxCards}" IsReadOnly="True"
                          AutoGenerateColumns="False"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Card Name" Width="*" SortMemberPath="CardName" CellTemplate="{StaticResource OracleCardNameCellTemplate}"/>
                        <DataGridTemplateColumn Header="Mana Cost" SortMemberPath="ManaValue" CellTemplate="{StaticResource DeckCardManaCostCellTemplate}"/>
                        <DataGridTemplateColumn Header="Card types" SortMemberPath="Type" CellTemplate="{StaticResource DeckCardTypeCellTemplate}"/>
                        <DataGridTextColumn Header="#" Width="Auto" Binding="{Binding AllocatedQuantity}"/>
                    </DataGrid.Columns>
                    <i:Interaction.Behaviors>
                        <behaviors:DeckBuilderDragOracleCardSourceBehavior/>
                    </i:Interaction.Behaviors>
                </DataGrid>
            </GroupBox>

            <!-- 5 - Bottom: Filterable oracle card source -->
            <Grid Grid.Row="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Card pool" FontWeight="SemiBold"/>
                    <TextBlock Text="ⓘ" Margin="5,0,0,0" Opacity="0.65"
                               ToolTip="Drag selected cards to a deck zone to add 1 copy of each. Hold Shift while dragging to add 4 copies of each."/>
                </StackPanel>
                <DataGrid x:Name="AvailableCardsDataGrid"
                          Grid.Row="1"
                          ItemsSource="{Binding CardsVM.FilteredCards, NotifyOnTargetUpdated=True}"
                          SelectedItem="{Binding SelectedOracleCard, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Style="{StaticResource CardGridBaseStyle}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseDoubleClick">
                            <i:InvokeCommandAction Command="{Binding AddOracleCardToDeckCommand}" CommandParameter="{Binding SelectedItem, ElementName=AvailableCardsDataGrid}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <i:Interaction.Behaviors>
                        <behaviors:DeckBuilderDragOracleCardSourceBehavior />
                    </i:Interaction.Behaviors>
                    <DataGrid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="+ 1 card to deck" Style="{StaticResource BelerenBold}"
                                  Command="{Binding AddOracleCardToDeckCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="+ 4 cards to deck" Style="{StaticResource BelerenBold}"
                                  Command="{Binding AddOracleCardPlaySetToDeckCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="+ 1 to Maybeboard" Style="{StaticResource BelerenBold}"
                                  Command="{Binding AddOracleCardToMaybeboardCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Set as Commander" Style="{StaticResource BelerenBold}"
                                  Visibility="{Binding CanSetSelectedOracleCardAsCommander, Converter={StaticResource BoolToVisibilityConverter}}"
                                  Command="{Binding SetOracleCardAsCommanderCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Set as Companion" Style="{StaticResource BelerenBold}"
                                  Visibility="{Binding CanSetSelectedOracleCardAsCompanion, Converter={StaticResource BoolToVisibilityConverter}}"
                                  Command="{Binding SetOracleCardAsCompanionCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="Name">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <sharedElements:FilterHeaderUserControl DataContext="{Binding DataContext.NameFilter, ElementName=AvailableCardsDataGrid}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Mana Cost" Width="Auto" IsReadOnly="True" SortMemberPath="ManaValue">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding ManaCostImage}" Height="20" HorizontalAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Card Types" Width="*" SortMemberPath="Type">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Type}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </AdornerDecorator>
</UserControl>
