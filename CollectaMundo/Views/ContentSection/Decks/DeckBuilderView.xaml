<UserControl x:Class="CollectaMundo.Views.ContentSection.Decks.DeckBuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:deckViewModels="clr-namespace:CollectaMundo.ViewModels.Decks"
             xmlns:sharedElements="clr-namespace:CollectaMundo.Views.ContentSection.Pages.SharedElements"             
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=deckViewModels:DeckBuilderViewModel}"
             d:Style="{StaticResource {x:Type UserControl}}"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0 - Header + back button -->
            <RowDefinition Height="Auto"/>  <!-- 1 - Top: Deck list + Stats -->
            <RowDefinition Height="Auto"/>  <!-- 2 - Filter criteria summary -->
            <RowDefinition Height="3*"/>    <!-- 3- Bottom: Filterable oracle card source -->
        </Grid.RowDefinitions>

        <!-- 0 - Header + back button -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Label DockPanel.Dock="Left" Content="{Binding DeckName}" Style="{StaticResource MediumHeaderLabelStyle}"/>

            <Button Content="Back to Decks"
                    Width="120"
                    Height="24"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Command="{Binding BackToDeckManagementCommand}"/>
        </DockPanel>

        <!-- 1 - Top: Deck list + Stats -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>  <!-- 0 - deck -->
                <ColumnDefinition Width="10"/>  <!-- 1 - separator column -->
                <ColumnDefinition Width="*"/>   <!-- 2 - stats -->
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0 - deck and stats -->
                <RowDefinition Height="Auto"/> <!-- 1 - sideboard and commander(s) -->
                <RowDefinition Height="Auto"/> <!-- 2 - idea pad -->
            </Grid.RowDefinitions>

            <!-- Deck -->
            <GroupBox Grid.Column="0" Grid.Row ="0" Header="Deck">
                <DataGrid x:Name="DeckCardsDataGrid"
                          ItemsSource="{Binding MainboardZone.Cards}"
                          SelectedItem="{Binding SelectedDeckCard, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Style="{StaticResource CardGridBaseStyle}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Card Name" Width="*" SortMemberPath="CardName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CardName}" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Mana Cost" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding ManaCostImage}" Height="20" HorizontalAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Owned" Width="70" Binding="{Binding OwnedQuantity}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Allocated" Width="80" Binding="{Binding AllocatedQuantity}" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="+">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="+" Style="{StaticResource StepperButtonStyle}" 
                                            Command="{Binding DataContext.IncrementDeckCardQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Quantity">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <sharedElements:NumericEditorUserControl DataContext="{Binding DesiredQuantityBinding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="-">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="-" Style="{StaticResource StepperButtonStyle}"
                                            Command="{Binding DataContext.DecrementDeckCardQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Remove from deck"
                                      Command="{Binding PlacementTarget.DataContext.DeleteDeckCardsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.InputBindings>
                        <KeyBinding Key="Delete"
                                        Command="{Binding DeleteDeckCardsCommand}"
                                        CommandParameter="{Binding SelectedItems,RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    </DataGrid.InputBindings>
                </DataGrid>
            </GroupBox>

            <!-- Stats placeholder -->
            <GroupBox Grid.Column="2" Grid.Row="0" Header="Stats">
                <StackPanel Margin="8">
                    <TextBlock Text="Deck stats will go here later."
                               TextWrapping="Wrap"
                               Opacity="0.7"/>

                    <Separator Margin="0,8"/>

                    <TextBlock/>
                    <TextBlock/>
                    <TextBlock/>
                    <TextBlock/>
                </StackPanel>
            </GroupBox>

            <!-- Sideboard -->
            <GroupBox Grid.Column="0" Grid.Row ="1" Header="Sideboard">
                <DataGrid x:Name="SideboardDataGrid"
                          ItemsSource="{Binding SideboardZone.Cards}"
                          SelectedItem="{Binding SelectedDeckCard, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Style="{StaticResource CardGridBaseStyle}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Card Name" Width="*" SortMemberPath="CardName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CardName}" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Mana Cost" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding ManaCostImage}" Height="20" HorizontalAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="+">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="+" Style="{StaticResource StepperButtonStyle}" 
                                            Command="{Binding DataContext.IncrementDeckCardQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Quantity">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <sharedElements:NumericEditorUserControl DataContext="{Binding DesiredQuantityBinding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="-">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="-" Style="{StaticResource StepperButtonStyle}"
                                            Command="{Binding DataContext.DecrementDeckCardQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Remove from sideboard"
                                      Command="{Binding PlacementTarget.DataContext.DeleteDeckCardsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.InputBindings>
                        <KeyBinding Key="Delete"
                                        Command="{Binding DeleteDeckCardsCommand}"
                                        CommandParameter="{Binding SelectedItems,RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    </DataGrid.InputBindings>
                </DataGrid>
            </GroupBox>

            <!-- Command zone -->
            <GroupBox Grid.Column="2" Grid.Row ="1" Header="Command zone">
                <DataGrid x:Name="CommanderDataGrid"
                          ItemsSource="{Binding CommanderZone.Cards}"
                          SelectedItem="{Binding SelectedDeckCard, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Style="{StaticResource CardGridBaseStyle}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Card Name" Width="*" SortMemberPath="CardName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CardName}" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Mana Cost" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding ManaCostImage}" Height="20" HorizontalAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Remove from sideboard"
                                      Command="{Binding PlacementTarget.DataContext.DeleteDeckCardsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.InputBindings>
                        <KeyBinding Key="Delete"
                                        Command="{Binding DeleteDeckCardsCommand}"
                                        CommandParameter="{Binding SelectedItems,RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    </DataGrid.InputBindings>
                </DataGrid>
            </GroupBox>

            <!-- Companion zone -->
            <GroupBox Grid.Column="2" Grid.Row ="2" Header="Companion zone">
                <DataGrid x:Name="CompanionDataGrid"
                          ItemsSource="{Binding CompanionZone.Cards}"
                          SelectedItem="{Binding SelectedDeckCard, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Style="{StaticResource CardGridBaseStyle}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Card Name" Width="*" SortMemberPath="CardName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CardName}" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Mana Cost" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding ManaCostImage}" Height="20" HorizontalAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Remove from sideboard"
                                      Command="{Binding PlacementTarget.DataContext.DeleteDeckCardsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.InputBindings>
                        <KeyBinding Key="Delete"
                                        Command="{Binding DeleteDeckCardsCommand}"
                                        CommandParameter="{Binding SelectedItems,RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    </DataGrid.InputBindings>
                </DataGrid>
            </GroupBox>            
            
            <!-- Maybeboard -->
            <GroupBox Grid.Column="0" Grid.Row ="2" Header="Maybeboard">
                <DataGrid x:Name="MaybeboardDataGrid"
                          ItemsSource="{Binding MaybeboardZone.Cards}"
                          SelectedItem="{Binding SelectedDeckCard, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Style="{StaticResource CardGridBaseStyle}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Card Name" Width="*" SortMemberPath="CardName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CardName}" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Mana Cost" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding ManaCostImage}" Height="20" HorizontalAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="+">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="+" Style="{StaticResource StepperButtonStyle}" 
                                            Command="{Binding DataContext.IncrementDeckCardQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Quantity">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <sharedElements:NumericEditorUserControl DataContext="{Binding DesiredQuantityBinding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="-">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="-" Style="{StaticResource StepperButtonStyle}"
                                            Command="{Binding DataContext.DecrementDeckCardQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Remove from sideboard"
                                      Command="{Binding PlacementTarget.DataContext.DeleteDeckCardsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.InputBindings>
                        <KeyBinding Key="Delete"
                                        Command="{Binding DeleteDeckCardsCommand}"
                                        CommandParameter="{Binding SelectedItems,RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    </DataGrid.InputBindings>
                </DataGrid>
            </GroupBox>

        </Grid>

        <!-- 2 - Filter criteria summary and add-buttons -->
        <Grid Grid.Row="2" Margin="0,10,0,10">
            <ScrollViewer HorizontalAlignment="Left"
                  Height="20"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
                <TextBlock TextWrapping="Wrap"
                   Text="{Binding FilterVM.FilterSummary}"/>
            </ScrollViewer>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <Button Content="  Set as Companion  "
                        Height="20"
                        Margin="0,0,6,0"
                        Command="{Binding SetOracleCardAsCompanionCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=AvailableCardsDataGrid}"/>

                <Button Content="  Set as Commander  "
                        Height="20"
                        Margin="0,0,6,0"
                        Command="{Binding SetOracleCardAsCommanderCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=AvailableCardsDataGrid}"/>

                <Button Content="  + 1 to Maybeboard  "
                        Height="20"
                        Margin="0,0,6,0"
                        Command="{Binding AddOracleCardToMaybeboardCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=AvailableCardsDataGrid}"/>                
                
                <Button Content="  + 1 to sideboard  "
                        Height="20"
                        Margin="0,0,6,0"
                        Command="{Binding AddOracleCardToSideboardCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=AvailableCardsDataGrid}"/>

                <Button Content="  + 4 to deck  "
                        Height="20"
                        Margin="0,0,6,0"
                        Command="{Binding AddOracleCardPlaySetToDeckCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=AvailableCardsDataGrid}"/>

                <Button Content="  + 1 to deck  "
                        Height="20"
                        Command="{Binding AddOracleCardToDeckCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=AvailableCardsDataGrid}"/>
                
            </StackPanel>
        </Grid>

        <!-- 3- Bottom: Filterable oracle card source -->
        <Grid Grid.Row="3">
            <DataGrid x:Name="AvailableCardsDataGrid"
                      ItemsSource="{Binding CardsVM.FilteredCards, NotifyOnTargetUpdated=True}"
                      SelectedItem="{Binding SelectedOracleCard, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      Style="{StaticResource CardGridBaseStyle}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction Command="{Binding AddOracleCardToDeckCommand}" CommandParameter="{Binding SelectedItem, ElementName=AvailableCardsDataGrid}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Add 1 card to deck" Style="{StaticResource BelerenBold}"
                                          Command="{Binding AddOracleCardToDeckCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Add 4 cards to deck" Style="{StaticResource BelerenBold}"
                                          Command="{Binding AddOracleCardPlaySetToDeckCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="Name">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <sharedElements:FilterHeaderUserControl DataContext="{Binding DataContext.NameFilter, ElementName=AvailableCardsDataGrid}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Mana Cost" Width="Auto" IsReadOnly="True" SortMemberPath="ManaValue">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding ManaCostImage}" Height="20" HorizontalAlignment="Right"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Card Types" Width="*" SortMemberPath="Type">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Type}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
