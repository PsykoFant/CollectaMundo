<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:CollectaMundo"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:core="clr-namespace:Microsoft.Xaml.Behaviors.Core;assembly=Microsoft.Xaml.Behaviors"
    xmlns:topMenu="clr-namespace:CollectaMundo.Views.TopMenu"
    xmlns:viewmodels="clr-namespace:CollectaMundo.ViewModels"
    xmlns:presentation="clr-namespace:CollectaMundo.Presentation"
    xmlns:converters="clr-namespace:CollectaMundo.Presentation.Converters"
    xmlns:behaviors="clr-namespace:CollectaMundo.Presentation.Behaviors"
    xmlns:validation="clr-namespace:CollectaMundo.Presentation.Validation"
    xmlns:System="clr-namespace:System;assembly=System.Runtime" 
    x:Class="CollectaMundo.MainWindow"
    xmlns:sys="clr-namespace:System;assembly=mscorlib" 
    d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}"
    mc:Ignorable="d"    
    Title="CollectaMundo"
    Icon="/Resources/Images/Icon.ico" 
    Width="1920"
    Height="960"
    PreviewMouseDown="Window_PreviewMouseDown"
    Style="{StaticResource {x:Type Window}}">
    
    <Grid>
        <Grid x:Name="AppWindow" DataContext="{Binding Main}"  Visibility="{Binding MainGridVisibility}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Top menu -->
            <topMenu:TopMenuView Grid.Row="0"
                     Grid.ColumnSpan="3"
                     VerticalAlignment="Top"
                     HorizontalAlignment="Center"
                     Height="40" />
            <!-- Side menu -->
            <Grid  x:Name="SideMenu" Grid.Row="1" Grid.Column="0" Width="250" HorizontalAlignment="Left" Margin="0,0,0,0" Visibility="{Binding SideMenuVisibility}">
                <Grid x:Name="GridFiltering" Visibility="{Binding SideMenuFilterVisibility}" d:IsHidden="True">

                    <Button x:Name="ClearFiltersButton" Content="Clear filters" Margin="10,0,0,0" VerticalAlignment="Top" Height="20" Command="{Binding FilterVM.ClearFiltersCommand}"/>

                    <!--Color filtering-->
                    <ListBox ItemsSource="{Binding FilterVM.Filters[Colors].FilterOptions}"
                             SelectionMode="Extended" Margin="0,30,0,0" Width="120" HorizontalAlignment="Left"
                             Height="170" VerticalAlignment="Top" Background="{x:Null}" 
                             BorderBrush="{x:Null}" Foreground="{x:Null}">
                        <ListBox.Resources>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="SnapsToDevicePixels" Value="true" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <CheckBox Margin="5,2"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Content="{Binding OptionName}"
                                                      FontSize="{Binding ., Converter={StaticResource ColorlessFontConverter}, ConverterParameter=30}"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.Resources>
                    </ListBox>
                    <ListBox ItemsSource="{Binding ColorIcons.Cards}"
                             Margin="20,30,0,0" Width="50" HorizontalAlignment="Left"
                             Height="160" VerticalAlignment="Top" Background="{x:Null}" 
                             BorderBrush="{x:Null}" Foreground="{x:Null}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding ManaCostImage}" Height="15" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ComboBox DataContext="{Binding FilterVM.Filters[Colors]}"
                              Width="60"
                              Margin="190,35,0,0"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Right"
                              ItemsSource="{Binding AvailableOperators}"
                              SelectedItem="{Binding OperatorSelection, Mode=TwoWay}">
                    </ComboBox>

                    <!--Mana value filtering-->
                    <Label x:Name="ManaValueLabel" Content="Mana value is: " HorizontalAlignment="Left" Margin="0,190,0,0" VerticalAlignment="Top" Style="{StaticResource BelerenBold}"/>
                    <Grid Margin="10,215,0,0" VerticalAlignment="Top" Height="20" Width="240">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Operator Selection -->
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding FilterVM.Filters[ManaValue].AvailableOperators}"
                                  SelectedItem="{Binding FilterVM.Filters[ManaValue].OperatorSelection, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource OperatorToSymbolConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <!-- Numeric Value Selection -->
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding FilterVM.Filters[ManaValue].AvailableNumericOptions}"
                                  SelectedItem="{Binding FilterVM.Filters[ManaValue].SelectedNumericValue, Mode=TwoWay}"
                                  HorizontalAlignment="Right"
                                  Width="80"/>
                    </Grid>

                        <!--Rarity-->
                    <ComboBox DataContext="{Binding FilterVM.Filters[Rarity]}"
                                  IsDropDownOpen="{Binding IsDropDownOpen, Mode=TwoWay}"
                                  HorizontalAlignment="Left" VerticalAlignment="Top" 
                                  Margin="10,245,0,0" 
                                  Width="180" Height="20">
                            <ComboBox.Template>
                                <ControlTemplate TargetType="{x:Type ComboBox}">
                                    <Grid>
                                        <TextBox 
                                            Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                            Background="Transparent" Padding="3,3,0,0" Margin="0"
                                            Foreground="{Binding TextForeground, Mode=TwoWay}">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="GotFocus">
                                                <i:InvokeCommandAction Command="{Binding EmbeddedTextBoxGotFocusCommand}" />
                                                </i:EventTrigger>
                                                <i:EventTrigger EventName="LostFocus">
                                                <i:InvokeCommandAction Command="{Binding EmbeddedTextBoxLostFocusCommand}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                    <ToggleButton 
                                        Focusable="false"  ClickMode="Press" HorizontalAlignment="Right"
                                        IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                                        <TextBlock Text="{Binding ReadableLabel}" Margin="5,0"/>
                                    </ToggleButton>
                                    <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" StaysOpen="False">
                                        <Border Background="White" BorderThickness="1" BorderBrush="Black">
                                            <ListBox ItemsSource="{Binding FilteredOptions}" SelectionMode="Multiple"
                                                     VirtualizingPanel.IsVirtualizing="True"
                                                     ScrollViewer.CanContentScroll="True">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <VirtualizingStackPanel />
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.Resources>
                                                    <Style TargetType="{x:Type ListBoxItem}">
                                                        <Setter Property="SnapsToDevicePixels" Value="true"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                                    <CheckBox Margin="5,2"
                                                                      Width="225"
                                                                      Content="{Binding OptionName}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      HorizontalContentAlignment="Left">
                                                                        <CheckBox.ContentTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding}" 
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   ToolTip="{Binding}" 
                                                                                   MaxWidth="215"
                                                                                   TextWrapping="NoWrap" />
                                                                            </DataTemplate>
                                                                        </CheckBox.ContentTemplate>
                                                                    </CheckBox>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.Resources>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </ControlTemplate>
                        </ComboBox.Template>
