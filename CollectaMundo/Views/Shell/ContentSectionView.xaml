<UserControl x:Class="CollectaMundo.Views.Shell.ContentSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"             
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:behaviors="clr-namespace:CollectaMundo.Presentation.Behaviors"
             xmlns:viewmodels="clr-namespace:CollectaMundo.ViewModels"
             xmlns:presentation="clr-namespace:CollectaMundo.Presentation"
             xmlns:converters="clr-namespace:CollectaMundo.Presentation.Converters"
             xmlns:validation="clr-namespace:CollectaMundo.Presentation.Validation"
             xmlns:pages="clr-namespace:CollectaMundo.Views.Pages"
             d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Image Source="/Resources/Images/Logo.png"
                       Stretch="Fill"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Center"
                       Height="170"
                       Width="170"
                       RenderTransformOrigin="0.5,0.5"
                       Margin="0,70,0,0"
                       Opacity="0.8" 
                       Visibility="{Binding MiniLogoVisibility}"/>
        <ScrollViewer HorizontalAlignment="Center" Margin="0,240,0,0" VerticalAlignment="Top" Height="40" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Visibility="{Binding MiniLogoVisibility}">
            <TextBlock HorizontalAlignment="Center" Margin="0,0,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Text="{Binding FilterVM.FilterSummary}"/>
        </ScrollViewer>
        <!-- Search and Filter -->
        <pages:SearchAndFilterPageView Visibility="{Binding CurrentPage,
            Converter={StaticResource PageToVisibilityConverter},
            ConverterParameter={x:Static presentation:Page.SearchAndFilter}}" 
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"/>
        
        <!-- My Collection -->
        <pages:MyCollectionPageView Visibility="{Binding CurrentPage,
            Converter={StaticResource PageToVisibilityConverter},
            ConverterParameter={x:Static presentation:Page.MyCollection}}" 
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"/>

        <!-- Decks -->
        <pages:DecksPageView Visibility="{Binding CurrentPage,
            Converter={StaticResource PageToVisibilityConverter},
            ConverterParameter={x:Static presentation:Page.Decks}}" 
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"/>

        <!-- Utilities -->
        <pages:UtilitiesPageView Visibility="{Binding CurrentPage,
            Converter={StaticResource PageToVisibilityConverter},
            ConverterParameter={x:Static presentation:Page.Utilities}}" 
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"/>

    </Grid>
</UserControl>
