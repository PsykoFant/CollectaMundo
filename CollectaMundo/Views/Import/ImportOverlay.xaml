<UserControl x:Class="CollectaMundo.ImportOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CollectaMundo"
             xmlns:views="clr-namespace:CollectaMundo.Views.Import"
             xmlns:vm="clr-namespace:CollectaMundo.ViewModels"
             xmlns:vmsteps="clr-namespace:CollectaMundo.ViewModels.ImportSteps"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:ImportViewModel}"
             Style="{StaticResource {x:Type UserControl}}"
             Visibility="{Binding ImportOverlayVisibility}">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
        <Label Content="{Binding ProgressStep}" Style="{StaticResource MediumHeaderLabelStyle}" />
        <Label Content="{Binding ProgressHeadline}" Style="{StaticResource BigHeaderLabelStyle}" />

        <Image Source="/Resources/Images/counterspell_fail.png"
                   Visibility="{Binding ImportFailVisibility}"
                   Stretch="None"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Center"

                   Margin="0,150,0,0"/>

        <ContentControl Content="{Binding CurrentStepViewModel}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <ContentControl.Resources>
                <DataTemplate DataType="{x:Type vmsteps:ImportStep01_StartViewModel}">
                    <views:ImportStep01_StartView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vmsteps:ImportStep02_IdMappingViewModel}">
                    <views:ImportStep02_IdMappingView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vmsteps:ImportStep03_NameSetMappingViewModel}">
                    <views:ImportStep03_NameSetMappingView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vmsteps:ImportStep04_MultipleUuidsViewModel}">
                    <views:ImportStep04_MultipleUuuidsView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vmsteps:ImportStep05_AdditionalFieldsMappingViewModel}">
                    <views:ImportStep05_AdditionalFieldsMappingView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vmsteps:ImportStep10_FinishViewModel}">
                    <views:ImportStep10_FinishView />
                </DataTemplate>            
            </ContentControl.Resources>
        </ContentControl>

        <ProgressBar Value="{Binding ProgressValue}"
                     Style="{StaticResource CollectaMundoProgressBarStyle}" 
                     Margin="0,580,0,0"
                     Visibility="{Binding ProgressVisibility}"/>

        <Button Content="{Binding CurrentStepViewModel.PrimaryActionButtonText}"
                Command="{Binding PrimaryActionCommand}"
                IsEnabled="{Binding IsPrimaryActionButtonEnabled}"
                HorizontalAlignment="Center"
                Margin="0,610,0,0"
                VerticalAlignment="Top"/>

        <Label Content="{Binding ProgressDetailMessage}" HorizontalAlignment="Center" Margin="0,640,0,0" VerticalAlignment="Top"/>

        <Button Content="{Binding CurrentStepViewModel.SecondaryActionButtonText}"
                Command="{Binding SecondaryActionCommand}"
                IsEnabled="{Binding IsSecondaryActionButtonEnabled}"
                Visibility="{Binding CurrentStepViewModel.SecondaryActionVisibility}"
                HorizontalAlignment="Right"
                Margin="0,610,10,0"
                VerticalAlignment="Top"/>
        
        <Button Content="  Cancel import &#x274C;  "
                Command="{Binding CancelCommand}"
                Visibility="{Binding CancelVisibility}"
                HorizontalAlignment="Left"
                Margin="10,610,0,0"
                VerticalAlignment="Top"/>
        

    </Grid>
</UserControl>
