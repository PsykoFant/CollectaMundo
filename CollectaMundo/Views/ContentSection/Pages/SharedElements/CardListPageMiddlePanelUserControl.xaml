<UserControl x:Class="CollectaMundo.Views.ContentSection.Pages.SharedElements.CardListPageMiddlePanelUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:pagesVm="clr-namespace:CollectaMundo.ViewModels.Pages.SharedElements"
             xmlns:sharedElements="clr-namespace:CollectaMundo.Views.ContentSection.Pages.SharedElements"
             xmlns:pagespecificElements="clr-namespace:CollectaMundo.Views.ContentSection.Pages.PagespecificElements"
             xmlns:behaviors="clr-namespace:CollectaMundo.Presentation.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=pagesVm:CardListPageViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="450"
             d:DesignWidth="600">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>    <!-- 0 -->
            <RowDefinition Height="180"/>   <!-- 1 -->
            <RowDefinition Height="40"/>   <!-- 2 -->
        </Grid.RowDefinitions>

        <!-- Filter counts x out of y -->
        <Label Grid.Row="0"  
               Visibility="{Binding ShowCounts, Converter={StaticResource BoolToVisibilityConverter}}"
               HorizontalAlignment="Left"
               VerticalAlignment="Top">
            <Label.Content>
                <MultiBinding Converter="{StaticResource CountToSummaryConverter}">
                    <Binding Path="CardsVM.FilteredCount"/>
                    <Binding Path="CardsVM.TotalCount"/>
                </MultiBinding>
            </Label.Content>
        </Label>

        <Button Grid.Row="0" 
                Content="{Binding PrimarySubmitButtonText}"
                HorizontalAlignment="Right"

                VerticalAlignment="Top"
                Width="200"
                Height="20"
                Visibility="{Binding IsCollectionEditVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                Command="{Binding PrimarySubmitCommand}" />

        <Button Grid.Row="0" 
                Content="Clear cards without submitting"
                HorizontalAlignment="Right"
                Margin="0,0,210,0"
                VerticalAlignment="Top"
                Width="200"
                Height="20"
                Visibility="{Binding IsCollectionEditVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                Command="{Binding ClearPendingChangesCommand}" />

        <Grid Grid.Row="1">
            <Image Source="/Resources/Images/Logo.png"
                   Visibility="{Binding ShowCounts, Converter={StaticResource BoolToVisibilityConverter}}"
                   Stretch="Fill"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Center"
                   Height="170"
                   Width="170"
                   RenderTransformOrigin="0.5,0.5"
                   Opacity="0.8"/>
            
            <pagespecificElements:ListViewCardEditSearchAndFilter Visibility="{Binding IsSearchEditPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
            <pagespecificElements:ListViewCardEditMyCollection Visibility="{Binding IsMyCollectionEditPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>

        <ScrollViewer Grid.Row="1"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock TextWrapping="Wrap"
                       VerticalAlignment="Top"
                       Text="{Binding StatusMessage}" />
        </ScrollViewer>

        <!-- Filter criteria summary -->
        <ScrollViewer Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top" Height="40" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <TextBlock HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Top" Text="{Binding FilterVM.FilterSummary}"/>
        </ScrollViewer>
    </Grid>
</UserControl>
