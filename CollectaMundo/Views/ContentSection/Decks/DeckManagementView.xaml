<UserControl x:Class="CollectaMundo.Views.ContentSection.Decks.DeckManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:CollectaMundo.Presentation.Behaviors"
             xmlns:deckManagement="clr-namespace:CollectaMundo.ViewModels.Decks"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=deckManagement:DeckManagementViewModel}"
             d:Style="{StaticResource {x:Type UserControl}}"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0"
               Content="Manage Decks"
               Style="{StaticResource BigHeaderLabelStyle}" />

        <Label Grid.Row="1"
               Content="{Binding ModeMessage}"
               Style="{StaticResource SmallHeaderLabelStyle}" />

        <StackPanel Grid.Row="2"
                    Margin="0,16,0,0"
                    Width="420"
                    HorizontalAlignment="Center">

            <Label Content="Deck name:" />
            <TextBox Text="{Binding DeckName, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding SaveEditEnabled}"
                     Margin="0,0,0,10" />

            <Label Content="Format:" />
            <ComboBox ItemsSource="{Binding DeckFormats}"
                      SelectedItem="{Binding SelectedDeckFormat, Mode=TwoWay}"
                      IsEnabled="{Binding SaveEditEnabled}"
                      Margin="0,0,0,10" />

            <Label Content="Description:" />
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding SaveEditEnabled}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     MinHeight="70"
                     MaxHeight="90"
                     Margin="0,0,0,14" />

            <Grid Width="420">
                <Button Content="{Binding SubmitButtonText}"
                        Command="{Binding SubmitDeckCommand}"
                        IsEnabled="{Binding SaveEditEnabled}"
                        Width="100"
                        Height="20"
                        HorizontalAlignment="Left" />

                <Button Content="Cancel"
                        Command="{Binding CancelEditCommand}"
                        Width="60"
                        Height="20"
                        HorizontalAlignment="Center"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}" />

                <Button Content="{Binding DeleteButtonText}"
                        Command="{Binding DeleteSelectedDecksCommand}"
                        Width="100"
                        Height="20"
                        HorizontalAlignment="Right"
                        Visibility="{Binding HasSelectedDecks, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Margin="0,16,0,0"
                   Text="{Binding StatusMessage}"
                   Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap" />

        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding Decks}"
                  SelectedItem="{Binding SelectedDeck, Mode=TwoWay}"
                  behaviors:DataGridSelectedItemsBehavior.SyncedSelectedItems="{Binding SelectedDecks}"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  Style="{StaticResource DataGridBaseStyle}"
                  MinHeight="40"
                  Margin="0,10,0,0"
                  AutoGenerateColumns="False">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Name"
                                    Width="2*"
                                    Binding="{Binding Name}" />

                <DataGridTextColumn Header="Format"
                                    Width="110"
                                    Binding="{Binding Format}" />

                <DataGridTextColumn Header="Description"
                                    Width="3*"
                                    Binding="{Binding Description}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
