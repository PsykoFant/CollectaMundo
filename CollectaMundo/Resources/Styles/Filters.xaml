<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:i="http://schemas.microsoft.com/xaml/behaviors">

    <!-- Filter menu styles -->
    <Style x:Key="FilterComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Width" Value="180"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style x:Key="FilterComboBoxOperatorsStyle" TargetType="ComboBox">
        <Setter Property="Width" Value="60"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style x:Key="FilterMultiSelectComboStyle" TargetType="ComboBox" BasedOn="{StaticResource FilterComboBoxStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                         Background="Transparent"
                                         Padding="3,3,0,0"
                                         Margin="0"
                                         Foreground="{Binding TextForeground, Mode=TwoWay}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="GotFocus">
                                    <i:InvokeCommandAction Command="{Binding EmbeddedTextBoxGotFocusCommand}" />
                                </i:EventTrigger>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding EmbeddedTextBoxLostFocusCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>

                        <ToggleButton Focusable="False"
                                              ClickMode="Press"
                                              HorizontalAlignment="Right"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <TextBlock Text="{Binding ReadableLabel}" Margin="5,0"/>
                        </ToggleButton>

                        <Popup x:Name="Popup"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       StaysOpen="False">
                            <Border Background="White"
                                BorderThickness="1"
                                BorderBrush="Black">
                                <ListBox ItemsSource="{Binding FilteredOptions}"
                                     SelectionMode="Multiple"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     ScrollViewer.CanContentScroll="True">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.Resources>
                                        <Style TargetType="{x:Type ListBoxItem}">
                                            <Setter Property="SnapsToDevicePixels" Value="True"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                        <CheckBox Margin="5,2"
                                                              Width="225"
                                                              Content="{Binding OptionName}"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              HorizontalContentAlignment="Left">
                                                            <CheckBox.ContentTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding}"
                                                                           MaxWidth="215"
                                                                           TextWrapping="NoWrap" />
                                                                </DataTemplate>
                                                            </CheckBox.ContentTemplate>
                                                        </CheckBox>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.Resources>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
